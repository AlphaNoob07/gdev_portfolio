---
interface Props {
  compact?: boolean;
}
---

<header class="lp-nav" data-lp-nav>
  <div class="lp-nav-inner">
    <a href="/#top" class="lp-brand" aria-label="Swapon Islam — Home">
      <svg class="lp-monogram" width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
        <path
          d="M17.5 7.5C15.8 6.4 13.7 6 11.8 6.5C9.4 7.1 8 8.8 8 10.9C8 13.2 9.9 14.3 13.1 15.1C16.2 15.9 18.2 17 18.2 19.6C18.2 22.1 15.9 23.8 12.6 23.8C10.1 23.8 8 22.9 6.6 21.4"
          stroke="#F4F8FB"
          stroke-width="2.6"
          stroke-linecap="round"
        />
        <rect x="20.5" y="19.5" width="4.5" height="4.5" rx="1" fill="#3EE0A0" />
      </svg>
    </a>

    <nav class="lp-nav-links" aria-label="Primary navigation">
      <a href="/#about" data-nav-section="about">About</a>
      <a href="/#services" data-nav-section="services">Expertise</a>
      <a href="/#projects" data-nav-section="projects">Projects</a>
      <a href="/#experience" data-nav-section="experience">Experience</a>
      <a href="/resume/Swapon-Islam-Resume.pdf" target="_blank" rel="noopener">
        R&eacute;sum&eacute;
      </a>
      <button type="button" class="lp-nav-contact" data-open-contact>
        Contact
      </button>
    </nav>

    <button
      type="button"
      class="lp-nav-burger"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      data-lp-burger
    >
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="lp-mobile-drawer" data-lp-drawer hidden>
    <a href="/#about" data-lp-close-drawer>About</a>
    <a href="/#services" data-lp-close-drawer>Expertise</a>
    <a href="/#projects" data-lp-close-drawer>Projects</a>
    <a href="/#experience" data-lp-close-drawer>Experience</a>
    <a
      href="/resume/Swapon-Islam-Resume.pdf"
      target="_blank"
      rel="noopener"
      data-lp-close-drawer
    >
      R&eacute;sum&eacute; (PDF)
    </a>
    <button
      type="button"
      class="lp-mobile-cta"
      data-open-contact
      data-lp-close-drawer
    >
      Contact me
    </button>
  </div>
</header>

<style>
  .lp-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-nav);
    background: rgba(14, 23, 38, 0.94);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid transparent;
    transition: background-color 220ms ease, border-color 220ms ease;
  }

  .lp-nav-inner {
    max-width: var(--container-max);
    margin-inline: auto;
    padding: 0.95rem clamp(1.25rem, 4vw, 2.5rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .lp-brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    transition: transform 200ms var(--ease-spring);
  }

  .lp-brand:hover {
    transform: scale(1.06);
  }

  .lp-nav-links {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.2vw, 2rem);
  }

  .lp-nav-links a,
  .lp-nav-contact {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--lp-text);
    text-decoration: none;
    background: none;
    border: none;
    padding: 0.25rem 0;
    cursor: pointer;
    transition: color 180ms ease;
  }

  .lp-nav-links a:hover,
  .lp-nav-links a.is-active,
  .lp-nav-contact:hover {
    color: var(--lp-accent);
  }

  .lp-nav-links a.is-active {
    position: relative;
  }

  .lp-nav-links a.is-active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 2px;
    border-radius: 2px;
    background: var(--lp-accent);
  }

  .lp-nav-contact {
    padding: 0.42rem 0.95rem;
    border-radius: 9999px;
    border: 1px solid transparent;
    background: rgba(62, 224, 160, 0.1);
    color: var(--lp-accent);
  }

  .lp-nav-contact:hover {
    background: var(--lp-accent);
    color: #09101b;
  }

  .lp-nav-burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 38px;
    height: 38px;
    padding: 8px;
    border-radius: 10px;
    border: 1px solid var(--lp-border);
    background: rgba(215, 226, 234, 0.04);
    cursor: pointer;
  }

  .lp-nav-burger span {
    display: block;
    width: 100%;
    height: 1.5px;
    background: var(--lp-text-strong);
    transition: transform 200ms ease;
  }

  .lp-mobile-drawer {
    display: grid;
    gap: 0.35rem;
    padding: 1rem clamp(1.25rem, 4vw, 2.5rem) 1.5rem;
    background: #0e1726;
    border-bottom: 1px solid var(--lp-border);
  }

  .lp-mobile-drawer[hidden] {
    display: none;
  }

  .lp-mobile-drawer a {
    padding: 0.7rem 0.25rem;
    color: var(--lp-text);
    text-decoration: none;
    font-size: 1rem;
    font-weight: 500;
    border-bottom: 1px solid rgba(215, 226, 234, 0.06);
  }

  .lp-mobile-cta {
    margin-top: 0.75rem;
    padding: 0.8rem 1.25rem;
    border-radius: 9999px;
    border: none;
    background: var(--lp-accent);
    color: #09101b;
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
  }

  @media (max-width: 780px) {
    .lp-nav-links {
      display: none;
    }

    .lp-nav-burger {
      display: inline-flex;
    }
  }
</style>

<script>
  let cleanupNav: (() => void) | null = null;

  function initLivingNav(): void {
    cleanupNav?.();
    const burger = document.querySelector<HTMLButtonElement>('[data-lp-burger]');
    const drawer = document.querySelector<HTMLElement>('[data-lp-drawer]');
    if (!burger || !drawer) return;

    const controller = new AbortController();
    const { signal } = controller;

    const toggle = (force?: boolean) => {
      const open = typeof force === 'boolean' ? force : drawer.hidden;
      drawer.hidden = !open;
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
    };

    burger.addEventListener('click', () => toggle(), { signal });
    drawer.querySelectorAll('[data-lp-close-drawer]').forEach((el) => {
      el.addEventListener('click', () => toggle(false), { signal });
    });
    window.addEventListener(
      'keydown',
      (e) => {
        if (e.key === 'Escape' && !drawer.hidden) toggle(false);
      },
      { signal }
    );

    // Active-section scroll spy
    const navLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('[data-nav-section]')
    );
    const sections = navLinks
      .map((a) => document.getElementById(a.dataset.navSection || ''))
      .filter((el): el is HTMLElement => el !== null);

    let observer: IntersectionObserver | null = null;
    if ('IntersectionObserver' in window && sections.length > 0) {
      observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const id = entry.target.id;
            navLinks.forEach((link) => {
              const active = link.dataset.navSection === id;
              link.classList.toggle('is-active', active);
              if (active) link.setAttribute('aria-current', 'location');
              else link.removeAttribute('aria-current');
            });
          });
        },
        { rootMargin: '-35% 0px -55% 0px' }
      );
      sections.forEach((sec) => observer?.observe(sec));
    }

    const clearAtTop = () => {
      if (window.scrollY < window.innerHeight * 0.55) {
        navLinks.forEach((l) => {
          l.classList.remove('is-active');
          l.removeAttribute('aria-current');
        });
      }
    };
    window.addEventListener('scroll', clearAtTop, { passive: true, signal });
    requestAnimationFrame(clearAtTop);

    cleanupNav = () => {
      controller.abort();
      observer?.disconnect();
    };
  }

  document.addEventListener('astro:page-load', initLivingNav);
</script>
