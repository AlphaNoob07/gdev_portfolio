<div class="lp-rail" data-scroll-rail aria-hidden="true">
  <svg viewBox="0 0 60 1000" preserveAspectRatio="none">
    <path
      class="lp-rail-track"
      d="M30 0 C 58 160, 2 300, 30 500 S 58 840, 30 1000"
    />
    <path
      class="lp-rail-fill"
      data-rail-fill
      d="M30 0 C 58 160, 2 300, 30 500 S 58 840, 30 1000"
      pathLength="1"
    />
  </svg>
</div>

<style>
  .lp-rail {
    position: fixed;
    top: 12vh;
    right: clamp(6px, 1.2vw, 22px);
    width: 40px;
    height: 76vh;
    z-index: 30;
    pointer-events: none;
    opacity: 0;
    transition: opacity 400ms ease;
  }

  .lp-rail.is-on {
    opacity: 1;
  }

  .lp-rail svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .lp-rail-track,
  .lp-rail-fill {
    fill: none;
    vector-effect: non-scaling-stroke;
  }

  .lp-rail-track {
    stroke: rgba(142, 161, 181, 0.22);
    stroke-width: 1.5;
  }

  .lp-rail-fill {
    stroke: var(--lp-accent);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    filter: drop-shadow(0 0 6px rgba(62, 224, 160, 0.75));
  }

  @media (max-width: 900px) {
    .lp-rail {
      display: none;
    }
  }
</style>

<script>
  let cleanupRail: (() => void) | null = null;

  function initRail(): void {
    cleanupRail?.();
    const rail = document.querySelector<HTMLElement>('[data-scroll-rail]');
    const fill = rail?.querySelector<SVGPathElement>('[data-rail-fill]');
    const start = document.getElementById('services');
    const end = document.getElementById('experience');
    if (!rail || !fill || !start || !end) return;

    const controller = new AbortController();
    let ticking = false;

    const update = () => {
      ticking = false;
      const top = start.offsetTop - window.innerHeight * 0.5;
      const bottom = end.offsetTop + end.offsetHeight - window.innerHeight;
      const y = window.scrollY;
      const pct = Math.min(1, Math.max(0, (y - top) / Math.max(1, bottom - top)));
      rail.classList.toggle('is-on', y > top && y < bottom + window.innerHeight * 0.4);
      fill.style.strokeDashoffset = String(1 - pct);
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true, signal: controller.signal });
    window.addEventListener('resize', onScroll, { passive: true, signal: controller.signal });
    update();
    cleanupRail = () => controller.abort();
  }

  document.addEventListener('astro:page-load', initRail);
</script>
