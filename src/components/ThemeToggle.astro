<button
  type="button"
  class="theme-toggle glass-pill"
  data-theme-toggle
  aria-label="Toggle color theme"
  aria-pressed="false"
>
  <span class="theme-toggle__icon theme-toggle__icon--sun" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2"></path>
      <path d="M12 20v2"></path>
      <path d="m4.93 4.93 1.41 1.41"></path>
      <path d="m17.66 17.66 1.41 1.41"></path>
      <path d="M2 12h2"></path>
      <path d="M20 12h2"></path>
      <path d="m6.34 17.66-1.41 1.41"></path>
      <path d="m19.07 4.93-1.41 1.41"></path>
    </svg>
  </span>
  <span class="theme-toggle__icon theme-toggle__icon--moon" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
    </svg>
  </span>
  <span class="theme-toggle__label">Theme</span>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-width: 40px;
    min-height: 40px;
    padding: 0.45rem 0.75rem;
    color: var(--text-primary);
    cursor: pointer;
    font-size: var(--text-xs);
    font-weight: 600;
    transition:
      background-color var(--duration-fast) ease,
      border-color var(--duration-fast) ease,
      transform var(--duration-fast) var(--ease-spring);
  }

  .theme-toggle:hover {
    background: var(--glass-pill-hover);
    border-color: var(--glass-border-strong);
  }

  .theme-toggle__label {
    display: none;
  }

  .theme-toggle__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  /* In dark mode (default), show Sun icon to switch to light; in light mode, show Moon */
  :global(:root) .theme-toggle__icon--moon {
    display: none;
  }

  :global([data-theme='light']) .theme-toggle__icon--sun {
    display: none;
  }

  :global([data-theme='light']) .theme-toggle__icon--moon {
    display: inline-flex;
  }

  @media (max-width: 900px) {
    .theme-toggle--labeled .theme-toggle__label {
      display: inline;
    }
  }
</style>

<script>
  const THEME_STORAGE_KEY = 'theme';
  let cleanupTheme: (() => void) | null = null;

  function readStoredTheme(): 'dark' | 'light' | null {
    try {
      const value = window.localStorage.getItem(THEME_STORAGE_KEY);
      return value === 'dark' || value === 'light' ? value : null;
    } catch {
      return null;
    }
  }

  function writeStoredTheme(theme: 'dark' | 'light'): void {
    try {
      window.localStorage.setItem(THEME_STORAGE_KEY, theme);
    } catch {
      // Ignore storage errors (private browsing / disabled storage)
    }
  }

  function getSystemTheme(): 'dark' | 'light' {
    return window.matchMedia('(prefers-color-scheme: light)').matches
      ? 'light'
      : 'dark';
  }

  function applyTheme(theme: 'dark' | 'light'): void {
    document.documentElement.dataset.theme = theme;
    const themeColor = theme === 'light' ? '#f5f7fc' : '#0b0c10';
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) {
      meta.setAttribute('content', themeColor);
    }

    const isLight = theme === 'light';
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
      btn.setAttribute('aria-pressed', isLight ? 'true' : 'false');
      btn.setAttribute(
        'aria-label',
        isLight ? 'Switch to dark theme' : 'Switch to light theme'
      );
    });
  }

  function initThemeToggle(): void {
    cleanupTheme?.();
    const controller = new AbortController();
    const { signal } = controller;

    const currentTheme =
      readStoredTheme() ??
      (document.documentElement.dataset.theme === 'light' ? 'light' : getSystemTheme());
    applyTheme(currentTheme);

    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
      btn.addEventListener(
        'click',
        () => {
          const active =
            document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
          const next: 'dark' | 'light' = active === 'light' ? 'dark' : 'light';
          writeStoredTheme(next);
          applyTheme(next);
        },
        { signal }
      );
    });

    const mediaQuery = window.matchMedia('(prefers-color-scheme: light)');
    mediaQuery.addEventListener(
      'change',
      () => {
        if (!readStoredTheme()) {
          applyTheme(getSystemTheme());
        }
      },
      { signal }
    );

    cleanupTheme = () => controller.abort();
  }

  document.addEventListener('astro:page-load', initThemeToggle);
</script>
