---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  showBlog?: boolean;
  brandName?: string;
}

const { showBlog = false, brandName = 'Swapon Islam' } = Astro.props;

interface NavItem {
  label: string;
  href: string;
  sectionId?: string;
}

const navItems: NavItem[] = [
  { label: 'Home', href: '/#home', sectionId: 'home' },
  { label: 'About', href: '/#about', sectionId: 'about' },
  { label: 'Skills', href: '/#skills', sectionId: 'skills' },
  { label: 'Experience', href: '/#experience', sectionId: 'experience' },
  { label: 'Projects', href: '/#projects', sectionId: 'projects' },
  { label: 'XR', href: '/#xr', sectionId: 'xr' },
  ...(showBlog ? [{ label: 'Blog', href: '/blog' }] : []),
  { label: 'Contact', href: '/#contact', sectionId: 'contact' },
];
---

<header class="nav-shell">
  <nav class="glass-surface glass-nav nav-pill" aria-label="Primary navigation">
    <a href="/#home" class="nav-brand" data-nav-link data-nav-section="home">
      <span class="nav-brand-dot" aria-hidden="true"></span>
      <span>{brandName}</span>
    </a>

    <ul class="nav-links">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="nav-link"
              data-nav-link
              data-nav-section={item.sectionId}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="nav-actions">
      <ThemeToggle />
      <button
        type="button"
        class="mobile-menu-btn glass-pill"
        data-mobile-nav-open
        aria-expanded="false"
        aria-controls="mobile-nav-sheet"
        aria-label="Open navigation menu"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 7h16"></path>
          <path d="M4 12h16"></path>
          <path d="M4 17h16"></path>
        </svg>
        <span>Menu</span>
      </button>
    </div>
  </nav>
</header>

<div
  id="mobile-nav-sheet"
  class="mobile-sheet-backdrop"
  data-mobile-sheet
  hidden
>
  <div
    class="glass-surface glass-sheet mobile-sheet"
    role="dialog"
    aria-modal="true"
    aria-label="Navigation menu"
  >
    <div class="mobile-sheet__handle" aria-hidden="true"></div>
    <div class="mobile-sheet__head">
      <span class="mobile-sheet__title">{brandName}</span>
      <button
        type="button"
        class="mobile-sheet__close glass-pill"
        data-mobile-nav-close
        aria-label="Close navigation menu"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </button>
    </div>

    <ul class="mobile-sheet__links">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="mobile-sheet__link"
              data-nav-link
              data-mobile-nav-link
              data-nav-section={item.sectionId}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .nav-shell {
    position: fixed;
    top: max(0.85rem, env(safe-area-inset-top));
    left: 0;
    right: 0;
    z-index: var(--z-nav);
    display: flex;
    justify-content: center;
    padding-inline: 1rem;
    pointer-events: none;
  }

  .nav-pill {
    pointer-events: auto;
    width: min(var(--container-max), 100%);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.45rem 0.55rem 0.45rem 1rem;
  }

  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: -0.015em;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-brand-dot {
    width: 9px;
    height: 9px;
    border-radius: 9999px;
    background: var(--accent-gradient);
    box-shadow: 0 0 12px rgba(96, 165, 250, 0.7);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    list-style: none;
    padding: 0;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-pill);
    text-decoration: none;
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-secondary);
    transition:
      background-color var(--duration-fast) ease,
      color var(--duration-fast) ease;
  }

  .nav-link:hover {
    color: var(--text-primary);
    background: var(--glass-pill-bg);
  }

  .nav-link.is-active {
    color: var(--text-primary);
    background: var(--glass-pill-hover);
    font-weight: 600;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .mobile-menu-btn {
    display: none;
    align-items: center;
    gap: 0.4rem;
    min-height: 40px;
    padding: 0.45rem 0.85rem;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-primary);
    cursor: pointer;
  }

  /* Mobile Glass Bottom Sheet */
  .mobile-sheet-backdrop {
    position: fixed;
    inset: 0;
    z-index: var(--z-sheet);
    background: rgba(5, 7, 12, 0.56);
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  .mobile-sheet-backdrop[hidden] {
    display: none;
  }

  .mobile-sheet {
    width: 100%;
    max-width: 540px;
    max-height: 82vh;
    overflow-y: auto;
    padding: 0.75rem 1.25rem calc(1.5rem + env(safe-area-inset-bottom));
    display: grid;
    gap: 1rem;
    border-bottom: none;
    box-shadow: 0 -20px 50px rgba(0, 0, 0, 0.45);
  }

  .mobile-sheet__handle {
    width: 40px;
    height: 4px;
    border-radius: 9999px;
    background: var(--glass-border-strong);
    justify-self: center;
  }

  .mobile-sheet__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mobile-sheet__title {
    font-size: var(--text-base);
    font-weight: 700;
  }

  .mobile-sheet__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    cursor: pointer;
  }

  .mobile-sheet__links {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }

  .mobile-sheet__link {
    display: flex;
    align-items: center;
    min-height: 46px;
    padding: 0.65rem 1rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--text-secondary);
    background: var(--glass-pill-bg);
    border: 1px solid transparent;
  }

  .mobile-sheet__link.is-active,
  .mobile-sheet__link:hover {
    color: var(--text-primary);
    background: var(--glass-pill-hover);
    border-color: var(--glass-border);
  }

  @media (max-width: 900px) {
    .nav-links {
      display: none;
    }

    .mobile-menu-btn {
      display: inline-flex;
    }
  }
</style>

<script>
  let cleanupNav: (() => void) | null = null;

  function initNavigation(): void {
    cleanupNav?.();
    const controller = new AbortController();
    const { signal } = controller;

    const navLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')
    );

    const setActiveSection = (sectionId: string) => {
      navLinks.forEach((link) => {
        if (link.classList.contains('nav-brand')) return;
        const matches = link.dataset.navSection === sectionId;
        link.classList.toggle('is-active', matches);
        if (matches) {
          link.setAttribute('aria-current', 'location');
        } else {
          link.removeAttribute('aria-current');
        }
      });
    };

    const sections = Array.from(
      document.querySelectorAll<HTMLElement>('section[id]')
    );

    let observer: IntersectionObserver | null = null;
    if (sections.length > 0 && 'IntersectionObserver' in window) {
      observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio);
          if (visible.length > 0) {
            setActiveSection(visible[0].target.id);
          }
        },
        {
          rootMargin: '-22% 0px -62% 0px',
          threshold: [0, 0.2, 0.5],
        }
      );

      sections.forEach((section) => observer?.observe(section));
    }

    // Mobile bottom sheet controls
    const backdrop = document.querySelector<HTMLElement>('[data-mobile-sheet]');
    const openBtn = document.querySelector<HTMLButtonElement>('[data-mobile-nav-open]');
    const closeBtn = document.querySelector<HTMLButtonElement>('[data-mobile-nav-close]');
    const sheetLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('[data-mobile-nav-link]')
    );

    const openSheet = () => {
      if (!backdrop || !openBtn) return;
      backdrop.hidden = false;
      openBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      closeBtn?.focus();
    };

    const closeSheet = (restoreFocus = true) => {
      if (!backdrop || !openBtn || backdrop.hidden) return;
      backdrop.hidden = true;
      openBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      if (restoreFocus) {
        openBtn.focus();
      }
    };

    openBtn?.addEventListener('click', openSheet, { signal });
    closeBtn?.addEventListener('click', () => closeSheet(true), { signal });
    backdrop?.addEventListener(
      'click',
      (event) => {
        if (event.target === backdrop) {
          closeSheet(true);
        }
      },
      { signal }
    );

    sheetLinks.forEach((link) => {
      link.addEventListener('click', () => closeSheet(false), { signal });
    });

    window.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'Escape') {
          closeSheet(true);
        }
      },
      { signal }
    );

    cleanupNav = () => {
      observer?.disconnect();
      controller.abort();
      document.body.style.overflow = '';
    };
  }

  document.addEventListener('astro:page-load', initNavigation);
</script>
