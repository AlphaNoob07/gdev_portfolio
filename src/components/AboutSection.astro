---
import GlassPanel from './GlassPanel.astro';
import type { ProfileData } from '../lib/content';

interface Props {
  profile: ProfileData;
}

const { profile } = Astro.props;
---

<section id="about" class="section reveal">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">About</span>
      <h2 class="section-title">Spatial Computing, Games &amp; Real-Time Simulation</h2>
    </div>

    <div class="about-grid">
      <GlassPanel variant="panel" padding="lg" interactive class="about-main">
        <div class="about-prose">
          {profile.about.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </GlassPanel>

      <div class="about-side">
        <GlassPanel as="article" variant="card" padding="md" interactive>
          <h3 class="about-card-title">Education</h3>
          <ul class="edu-list">
            {
              profile.education.map((edu) => (
                <li class="edu-item">
                  <strong>{edu.degree}</strong>
                  <span>{edu.institution}</span>
                  <span class="edu-period">{edu.period} · {edu.location}</span>
                </li>
              ))
            }
          </ul>
        </GlassPanel>

        <GlassPanel as="article" variant="card" padding="md" interactive>
          <h3 class="about-card-title">Core Strengths</h3>
          <div class="expertise-chips">
            {profile.expertise.map((item) => <span class="chip">{item}</span>)}
          </div>
        </GlassPanel>
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(260px, 0.9fr);
    gap: 1.25rem;
    align-items: start;
  }

  .about-prose {
    display: grid;
    gap: 1.05rem;
    color: var(--text-secondary);
    font-size: var(--text-base);
    line-height: 1.72;
  }

  .about-side {
    display: grid;
    gap: 1.15rem;
  }

  .about-card-title {
    font-size: var(--text-lg);
    font-weight: 650;
    margin-bottom: 0.85rem;
  }

  .edu-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.95rem;
  }

  .edu-item {
    display: grid;
    gap: 0.15rem;
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .edu-item strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  .edu-period {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .expertise-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.48rem;
  }

  @media (max-width: 860px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
