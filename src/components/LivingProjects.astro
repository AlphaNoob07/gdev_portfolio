---
import { Picture } from 'astro:assets';
import type { ProjectEntry } from '../lib/content';
import { isImageMetadata, resolveProjectImage } from '../lib/media';

interface Props {
  projects: ProjectEntry[];
}

const { projects } = Astro.props;

const filterCategories = ['XR', 'Games', 'AI'] as const;
const categories = ['All', ...filterCategories] as const;
const counts: Record<string, number> = { All: projects.length };
for (const cat of filterCategories) {
  counts[cat] = projects.filter((p) => p.data.categories.includes(cat)).length;
}
---

<section id="projects" class="lp-projects reveal" data-lp-projects>
  <div class="lp-container">
    <div class="lp-projects-top">
      <div class="lp-section-head">
        <span class="lp-eyebrow">Selected Work</span>
        <h2 class="lp-h2">Featured Projects</h2>
      </div>

      <div class="lp-filter-bar" role="tablist" aria-label="Filter projects by category">
        {
          categories.map((cat, idx) => (
            <button
              type="button"
              role="tab"
              class:list={['lp-filter-btn', idx === 0 && 'is-active']}
              aria-selected={idx === 0 ? 'true' : 'false'}
              data-lp-filter={cat}
            >
              <span>{cat}</span>
              <span class="lp-filter-count">{counts[cat] ?? 0}</span>
            </button>
          ))
        }
      </div>
    </div>

    <div class="lp-projects-stack" data-lp-project-list>
      {
        projects.map((project, index) => {
          const { data } = project;
          const highlights = [
            ...(data.caseStudy?.solutions ?? []),
            ...(data.caseStudy?.outcomes ?? []),
            ...(data.caseStudy?.objectives ?? []),
          ].slice(0, 4);
          const sysName = `${project.id.replace(/[^a-z0-9-]/gi, '')}.production.sys`;
          const posterAsset = resolveProjectImage(data.poster);
          const posterIsMetadata = isImageMetadata(posterAsset);
          const posterStringUrl = typeof posterAsset === 'string' ? posterAsset : undefined;
          const initiallyHidden = index >= 6;

          return (
            <article
              class:list={['lp-project-card', initiallyHidden && 'is-collapsed']}
              id={`project-${project.id}`}
              data-lp-card
              data-categories={data.categories.join(',')}
            >
              <div class="lp-project-main">
                <div class="lp-project-meta">
                  <span class="lp-domain-badge">{data.categories[0] ?? 'XR'}</span>
                  {data.year && <span class="lp-project-year">{data.year}</span>}
                </div>

                <h3 class="lp-project-title">
                  <a href={`/projects/${project.id}`}>{data.title}</a>
                </h3>
                <p class="lp-project-summary">{data.summary}</p>

                {highlights.length > 0 && (
                  <div class="lp-project-bullets">
                    <span class="lp-bullets-label">Key Architecture &amp; Delivery</span>
                    <ul>
                      {highlights.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </div>
                )}

                <div class="lp-project-tech">
                  {data.tech.map((t) => (
                    <span class="lp-tech-pill">{t}</span>
                  ))}
                </div>

                <div class="lp-project-links">
                  <a href={`/projects/${project.id}`} class="lp-case-link">
                    View Case Study &rarr;
                  </a>
                  {data.links?.live && (
                    <a
                      href={data.links.live}
                      target="_blank"
                      rel="noopener"
                      class="lp-ext-link"
                    >
                      Live Demo &#8599;
                    </a>
                  )}
                  {data.links?.repo && (
                    <a
                      href={data.links.repo}
                      target="_blank"
                      rel="noopener"
                      class="lp-ext-link"
                    >
                      GitHub &#8599;
                    </a>
                  )}
                </div>
              </div>

              <div class="lp-terminal">
                <div class="lp-term-bar" aria-hidden="true">
                  <div class="lp-term-dots">
                    <span></span>
                    <span></span>
                    <span></span>
                  </div>
                  <span class="lp-term-title">{sysName}</span>
                </div>

                {posterIsMetadata ? (
                  <a href={`/projects/${project.id}`} class="lp-term-media" aria-label={`Preview ${data.title}`}>
                    <Picture
                      src={posterAsset}
                      formats={['avif', 'webp']}
                      widths={[480, 800]}
                      sizes="(max-width: 920px) 100vw, 440px"
                      loading="lazy"
                      alt={`${data.title} preview`}
                      class="lp-term-img"
                    />
                  </a>
                ) : posterStringUrl ? (
                  <a href={`/projects/${project.id}`} class="lp-term-media" aria-label={`Preview ${data.title}`}>
                    <img
                      src={posterStringUrl}
                      alt={`${data.title} preview`}
                      loading="lazy"
                      class="lp-term-img"
                    />
                  </a>
                ) : (
                  <div class="lp-term-body" aria-hidden="true">
                    <div class="lp-term-line">
                      <span class="lp-term-prompt">$</span>
                      <span>inspect --module {String(index + 1).padStart(2, '0')} --target {data.categories.join('/')}</span>
                    </div>
                    <div class="lp-term-kv">
                      <span>ENGINE / STACK</span>
                      <strong>{data.tech.slice(0, 3).join(' · ')}</strong>
                    </div>
                    <div class="lp-term-kv">
                      <span>ROLE</span>
                      <strong>{data.role || 'XR & Game Developer'}</strong>
                    </div>
                  </div>
                )}

                <div class="lp-term-foot" aria-hidden="true">
                  <span class="lp-term-dot"></span>
                  <span>Status: Active Production &middot; Verified</span>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>

    {
      projects.length > 6 && (
        <div class="lp-projects-more">
          <button type="button" class="lp-btn-outline" data-lp-show-all>
            Show All {projects.length} Projects
          </button>
        </div>
      )
    }
  </div>
</section>

<style>
  .lp-projects {
    background: var(--lp-bg);
    padding-block: clamp(4.5rem, 8vw, 7rem);
  }

  .lp-container {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 2.5rem);
  }

  .lp-projects-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    margin-bottom: clamp(2.25rem, 4.5vw, 3.25rem);
  }

  .lp-eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--lp-accent);
    margin-bottom: 0.65rem;
  }

  .lp-h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.2vw, 3.35rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--lp-text-strong);
    margin: 0;
  }

  .lp-filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .lp-filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.95rem;
    border-radius: 9999px;
    border: 1px solid var(--lp-border);
    background: var(--lp-surface);
    color: var(--lp-text);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    cursor: pointer;
    transition: border-color 180ms ease, background-color 180ms ease, color 180ms ease;
  }

  .lp-filter-btn:hover {
    border-color: var(--lp-accent);
    color: var(--lp-text-strong);
  }

  .lp-filter-btn.is-active {
    background: var(--lp-accent);
    border-color: var(--lp-accent);
    color: #09101b;
    font-weight: 600;
  }

  .lp-filter-count {
    font-size: 0.7rem;
    opacity: 0.78;
  }

  .lp-projects-stack {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.25rem);
  }

  .lp-project-card {
    background: var(--lp-surface);
    border: 1px solid var(--lp-border);
    border-radius: 24px;
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.95fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: center;
    transition: border-color 220ms ease, transform 220ms var(--ease-spring);
  }

  .lp-project-card[hidden],
  .lp-project-card.is-collapsed {
    display: none;
  }

  .lp-project-card:hover {
    border-color: rgba(62, 224, 160, 0.36);
  }

  .lp-project-main {
    display: grid;
    gap: 1rem;
  }

  .lp-project-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
  }

  .lp-domain-badge {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--lp-accent);
    background: var(--lp-accent-dim);
    border: 1px solid rgba(62, 224, 160, 0.28);
    padding: 0.26rem 0.68rem;
    border-radius: 9999px;
  }

  .lp-project-year,
  .lp-generic-pill {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--lp-text-muted);
  }

  .lp-project-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 2.6vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .lp-project-title a {
    color: var(--lp-text-strong);
    text-decoration: none;
    transition: color 180ms ease;
  }

  .lp-project-title a:hover {
    color: var(--lp-accent);
  }

  .lp-project-summary {
    margin: 0;
    color: var(--lp-text);
    font-size: var(--text-base);
    line-height: 1.65;
  }

  .lp-project-bullets {
    display: grid;
    gap: 0.5rem;
  }

  .lp-bullets-label {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--lp-text-muted);
  }

  .lp-project-bullets ul {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.4rem;
    color: var(--lp-text);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .lp-project-bullets li::marker {
    color: var(--lp-accent);
  }

  .lp-project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .lp-tech-pill {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--lp-text);
    background: rgba(14, 23, 38, 0.75);
    border: 1px solid var(--lp-border);
    padding: 0.28rem 0.68rem;
    border-radius: 9999px;
  }

  .lp-project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 0.35rem;
  }

  .lp-case-link {
    font-family: var(--font-mono);
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--lp-accent);
    text-decoration: none;
  }

  .lp-case-link:hover {
    text-decoration: underline;
  }

  .lp-ext-link {
    font-family: var(--font-mono);
    font-size: 0.84rem;
    color: var(--lp-text);
    text-decoration: none;
  }

  .lp-ext-link:hover {
    color: var(--lp-accent);
  }

  .lp-terminal {
    background: #09101b;
    border: 1px solid var(--lp-border);
    border-radius: 16px;
    overflow: hidden;
    font-family: var(--font-mono);
    box-shadow: 0 18px 36px -16px rgba(0, 0, 0, 0.6);
  }

  .lp-term-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.7rem 1rem;
    background: rgba(215, 226, 234, 0.04);
    border-bottom: 1px solid var(--lp-border);
  }

  .lp-term-dots {
    display: flex;
    gap: 6px;
  }

  .lp-term-dots span {
    width: 9px;
    height: 9px;
    border-radius: 9999px;
  }

  .lp-term-dots span:first-child {
    background: #f87171;
  }

  .lp-term-dots span:nth-child(2) {
    background: #fbbf24;
  }

  .lp-term-dots span:nth-child(3) {
    background: #3ee0a0;
  }

  .lp-term-title {
    font-size: 0.72rem;
    color: var(--lp-text-muted);
  }

  .lp-term-media {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #0b1322;
  }

  :global(.lp-term-media picture),
  .lp-term-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 360ms var(--ease-spring);
  }

  .lp-term-media:hover .lp-term-img {
    transform: scale(1.03);
  }

  .lp-term-body {
    padding: 1.15rem 1rem;
    display: grid;
    gap: 0.85rem;
    font-size: 0.76rem;
  }

  .lp-term-line {
    display: flex;
    gap: 0.5rem;
    color: var(--lp-text);
    word-break: break-word;
  }

  .lp-term-prompt {
    color: var(--lp-accent);
  }

  .lp-term-kv {
    display: grid;
    gap: 0.2rem;
    padding-left: 0.75rem;
    border-left: 2px solid rgba(62, 224, 160, 0.35);
  }

  .lp-term-kv span {
    font-size: 0.66rem;
    color: var(--lp-text-muted);
    letter-spacing: 0.06em;
  }

  .lp-term-kv strong {
    color: var(--lp-text-strong);
    font-weight: 500;
  }

  .lp-term-foot {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1rem;
    background: rgba(62, 224, 160, 0.06);
    border-top: 1px solid var(--lp-border);
    font-size: 0.72rem;
    color: var(--lp-accent);
  }

  .lp-term-dot {
    width: 7px;
    height: 7px;
    border-radius: 9999px;
    background: var(--lp-accent);
    box-shadow: 0 0 8px rgba(62, 224, 160, 0.85);
  }

  .lp-projects-more {
    margin-top: 2.25rem;
    display: flex;
    justify-content: center;
  }

  .lp-btn-outline {
    padding: 0.78rem 1.65rem;
    border-radius: 9999px;
    border: 1px solid var(--lp-border-strong);
    background: transparent;
    color: var(--lp-text-strong);
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: border-color 180ms ease, color 180ms ease;
  }

  .lp-btn-outline:hover {
    border-color: var(--lp-accent);
    color: var(--lp-accent);
  }

  @media (max-width: 920px) {
    .lp-project-card {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  let cleanupLpProjects: (() => void) | null = null;

  function initLpProjects(): void {
    cleanupLpProjects?.();
    const root = document.querySelector<HTMLElement>('[data-lp-projects]');
    if (!root) return;

    const controller = new AbortController();
    const { signal } = controller;

    const filterBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-lp-filter]'));
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-lp-card]'));
    const showAllBtn = root.querySelector<HTMLButtonElement>('[data-lp-show-all]');
    let expanded = false;

    const applyFilter = (category: string) => {
      filterBtns.forEach((btn) => {
        const active = btn.dataset.lpFilter === category;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-selected', active ? 'true' : 'false');
      });

      let visibleIdx = 0;
      cards.forEach((card) => {
        const cats = (card.dataset.categories || '').split(',');
        const matches = category === 'All' || cats.includes(category);
        card.hidden = !matches;
        if (matches) {
          const shouldCollapse = category === 'All' && !expanded && visibleIdx >= 6;
          card.classList.toggle('is-collapsed', shouldCollapse);
          visibleIdx += 1;
        } else {
          card.classList.remove('is-collapsed');
        }
      });

      if (showAllBtn) {
        showAllBtn.hidden = category !== 'All' || expanded;
      }
    };

    filterBtns.forEach((btn) => {
      btn.addEventListener(
        'click',
        () => applyFilter(btn.dataset.lpFilter || 'All'),
        { signal }
      );
    });

    showAllBtn?.addEventListener(
      'click',
      () => {
        expanded = true;
        applyFilter('All');
      },
      { signal }
    );

    cleanupLpProjects = () => controller.abort();
  }

  document.addEventListener('astro:page-load', initLpProjects);
</script>
