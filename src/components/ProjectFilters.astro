---
import ProjectCard from './ProjectCard.astro';
import type { ProjectEntry } from '../lib/content';

interface Props {
  projects: ProjectEntry[];
}

const { projects } = Astro.props;

const FILTERS = ['All', 'XR', 'Unity', 'Unreal', 'Medical', 'AI', 'Games'] as const;
const featuredCount = projects.filter((p) => p.data.featured).length;
---

<section id="projects" class="section reveal" data-projects-section>
  <div class="container">
    <div class="projects-header">
      <div class="section-head projects-head">
        <span class="eyebrow">Projects</span>
        <h2 class="section-title">Featured Work &amp; Prototypes</h2>
        <p class="section-subtitle">
          {featuredCount} featured projects and {projects.length} total verified builds across XR, games, computer vision, and medical simulation.
        </p>
      </div>

      <p class="projects-count" aria-live="polite" data-projects-count>
        Showing {featuredCount} featured of {projects.length} projects
      </p>
    </div>

    <div class="filter-bar" role="group" aria-label="Filter projects by discipline">
      {
        FILTERS.map((filter) => (
          <button
            type="button"
            class:list={['filter-chip glass-pill', filter === 'All' && 'is-active']}
            data-filter-btn={filter}
            aria-pressed={filter === 'All' ? 'true' : 'false'}
          >
            {filter}
          </button>
        ))
      }
    </div>

    <div class="projects-grid">
      {
        projects.map((project) => (
          <ProjectCard
            project={project}
            initiallyCollapsed={!project.data.featured}
          />
        ))
      }
    </div>

    {
      projects.length > featuredCount && (
        <div class="projects-more">
          <button
            type="button"
            class="btn"
            data-toggle-all-projects
            aria-expanded="false"
          >
            Show all {projects.length} projects
          </button>
        </div>
      )
    }
  </div>
</section>

<style>
  .projects-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    margin-bottom: 1.35rem;
  }

  .projects-head {
    margin-bottom: 0;
  }

  .projects-count {
    font-size: var(--text-sm);
    color: var(--text-muted);
    font-weight: 500;
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .filter-chip {
    min-height: 38px;
    padding: 0.42rem 0.95rem;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-secondary);
    cursor: pointer;
    transition:
      background-color var(--duration-fast) ease,
      border-color var(--duration-fast) ease,
      color var(--duration-fast) ease;
  }

  .filter-chip:hover {
    color: var(--text-primary);
    background: var(--glass-pill-hover);
  }

  .filter-chip.is-active {
    background: var(--accent-gradient);
    border-color: transparent;
    color: var(--text-on-accent);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.25rem;
  }

  .projects-more {
    display: flex;
    justify-content: center;
    margin-top: 1.75rem;
  }
</style>

<script>
  let cleanupProjects: (() => void) | null = null;

  function initProjectFilters(): void {
    cleanupProjects?.();
    const section = document.querySelector<HTMLElement>('[data-projects-section]');
    if (!section) return;

    const controller = new AbortController();
    const { signal } = controller;

    const filterButtons = Array.from(
      section.querySelectorAll<HTMLButtonElement>('[data-filter-btn]')
    );
    const cards = Array.from(
      section.querySelectorAll<HTMLElement>('[data-project-card]')
    ).map((inner) => ({
      inner,
      article: inner.closest<HTMLElement>('.project-card'),
      id: inner.dataset.projectId || '',
      categories: (inner.dataset.categories || '').split(','),
      featured: inner.dataset.featured === 'true',
    }));

    const countEl = section.querySelector<HTMLElement>('[data-projects-count]');
    const showAllBtn = section.querySelector<HTMLButtonElement>(
      '[data-toggle-all-projects]'
    );

    let activeFilter = 'All';
    let showAll = false;
    const totalCount = cards.length;

    const applyFilter = () => {
      let visibleCount = 0;

      cards.forEach(({ article, categories, featured }) => {
        if (!article) return;
        const matchesCategory =
          activeFilter === 'All' || categories.includes(activeFilter);
        const matchesScope = activeFilter !== 'All' || showAll || featured;
        const visible = matchesCategory && matchesScope;

        article.classList.toggle('is-collapsed', !visible);
        article.hidden = !visible;
        if (visible) visibleCount += 1;
      });

      if (countEl) {
        if (activeFilter === 'All' && !showAll) {
          countEl.textContent = `Showing ${visibleCount} featured of ${totalCount} projects`;
        } else if (activeFilter === 'All') {
          countEl.textContent = `Showing all ${visibleCount} projects`;
        } else {
          countEl.textContent = `Showing ${visibleCount} ${activeFilter} project${visibleCount === 1 ? '' : 's'}`;
        }
      }

      if (showAllBtn) {
        showAllBtn.hidden = activeFilter !== 'All';
        showAllBtn.setAttribute('aria-expanded', showAll ? 'true' : 'false');
        showAllBtn.textContent = showAll
          ? 'Show featured only'
          : `Show all ${totalCount} projects`;
      }
    };

    filterButtons.forEach((btn) => {
      btn.addEventListener(
        'click',
        () => {
          activeFilter = btn.dataset.filterBtn || 'All';
          filterButtons.forEach((b) => {
            const isCurrent = b === btn;
            b.classList.toggle('is-active', isCurrent);
            b.setAttribute('aria-pressed', isCurrent ? 'true' : 'false');
          });
          applyFilter();
        },
        { signal }
      );
    });

    showAllBtn?.addEventListener(
      'click',
      () => {
        showAll = !showAll;
        applyFilter();
      },
      { signal }
    );

    // Desktop hover video playback (disabled on reduced motion)
    const prefersReducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;
    if (!prefersReducedMotion) {
      cards.forEach(({ article }) => {
        const video = article?.querySelector<HTMLVideoElement>('[data-preview-video]');
        if (!article || !video) return;

        article.addEventListener(
          'pointerenter',
          () => {
            video.play().catch(() => {});
          },
          { signal }
        );

        article.addEventListener(
          'pointerleave',
          () => {
            video.pause();
            video.currentTime = 0;
          },
          { signal }
        );
      });
    }

    // Jump-to-project handler for SkillUniverse, Timeline, and XRShowcase
    document.addEventListener(
      'click',
      (event) => {
        const trigger = (event.target as HTMLElement)?.closest<HTMLAnchorElement>(
          '[data-jump-project]'
        );
        const slug = trigger?.dataset.jumpProject;
        if (!slug) return;

        const targetCard = cards.find((c) => c.id === slug)?.article;
        if (!targetCard) return;

        if (targetCard.hidden || targetCard.classList.contains('is-collapsed')) {
          activeFilter = 'All';
          showAll = true;
          filterButtons.forEach((b) => {
            const isAll = b.dataset.filterBtn === 'All';
            b.classList.toggle('is-active', isAll);
            b.setAttribute('aria-pressed', isAll ? 'true' : 'false');
          });
          applyFilter();
        }

        cards.forEach((c) => c.article?.classList.remove('is-highlighted'));
        targetCard.classList.add('is-highlighted');
        window.setTimeout(() => {
          targetCard.classList.remove('is-highlighted');
        }, 2200);
      },
      { signal }
    );

    applyFilter();
    cleanupProjects = () => controller.abort();
  }

  document.addEventListener('astro:page-load', initProjectFilters);
</script>
