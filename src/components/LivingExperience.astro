---
import type { ExperienceEntry, ProfileData } from '../lib/content';

interface Props {
  entries: ExperienceEntry[];
  profile: ProfileData;
}

const { entries, profile } = Astro.props;
---

<section id="experience" class="lp-exp reveal">
  <div class="lp-container">
    <div class="lp-section-head">
      <span class="lp-eyebrow">Career Path</span>
      <h2 class="lp-h2">Work Experience &amp; Education</h2>
    </div>

    <div class="lp-timeline">
      {
        entries.map((entry) => (
          <article class="lp-timeline-item">
            <div class="lp-timeline-rail" aria-hidden="true">
              <span class="lp-timeline-node"></span>
            </div>

            <div class="lp-timeline-card">
              <div class="lp-timeline-top">
                <div>
                  <h3 class="lp-exp-role">{entry.data.role}</h3>
                  <p class="lp-exp-company">
                    {entry.data.company}
                    {entry.data.companyNote ? ` — ${entry.data.companyNote}` : ''}
                  </p>
                </div>
                <div class="lp-exp-meta">
                  <span class="lp-exp-period">{entry.data.period}</span>
                  <span class="lp-exp-loc">{entry.data.location}</span>
                </div>
              </div>

              {entry.data.responsibilities.length > 0 && (
                <ul class="lp-exp-bullets">
                  {entry.data.responsibilities.map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>
              )}

              {entry.data.tech.length > 0 && (
                <div class="lp-exp-tech">
                  {entry.data.tech.map((t) => (
                    <span class="lp-tech-pill">{t}</span>
                  ))}
                </div>
              )}
            </div>
          </article>
        ))
      }
    </div>

    {
      profile.education.length > 0 && (
        <div class="lp-edu-block">
          <h3 class="lp-edu-heading">Education &amp; Credentials</h3>
          <div class="lp-edu-grid">
            {profile.education.map((edu) => (
              <div class="lp-edu-card">
                <span class="lp-edu-period">
                  {edu.period}
                </span>
                <h4 class="lp-edu-degree">{edu.degree}</h4>
                <p class="lp-edu-inst">{edu.institution}</p>
              </div>
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  .lp-exp {
    background: var(--lp-bg);
    padding-block: clamp(4.5rem, 8vw, 7rem);
  }

  .lp-container {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 2.5rem);
  }

  .lp-section-head {
    margin-bottom: clamp(2.25rem, 4.5vw, 3.5rem);
  }

  .lp-eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--lp-accent);
    margin-bottom: 0.65rem;
  }

  .lp-h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.2vw, 3.35rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--lp-text-strong);
    margin: 0;
  }

  .lp-timeline {
    position: relative;
    display: grid;
    gap: 1.5rem;
  }

  .lp-timeline::before {
    content: '';
    position: absolute;
    left: 11px;
    top: 10px;
    bottom: 10px;
    width: 2px;
    background: linear-gradient(
      180deg,
      var(--lp-accent) 0%,
      rgba(215, 226, 234, 0.14) 100%
    );
  }

  .lp-timeline-item {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    gap: clamp(1rem, 2.5vw, 1.75rem);
    align-items: start;
  }

  .lp-timeline-rail {
    display: grid;
    place-items: center;
    padding-top: 1.5rem;
  }

  .lp-timeline-node {
    width: 12px;
    height: 12px;
    border-radius: 9999px;
    background: var(--lp-accent);
    box-shadow: 0 0 14px rgba(62, 224, 160, 0.8);
    border: 2px solid var(--lp-bg);
  }

  .lp-timeline-card {
    background: var(--lp-surface);
    border: 1px solid var(--lp-border);
    border-radius: 20px;
    padding: clamp(1.25rem, 2.8vw, 1.85rem);
    display: grid;
    gap: 1rem;
  }

  .lp-timeline-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .lp-exp-role {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    font-weight: 700;
    color: var(--lp-text-strong);
  }

  .lp-exp-company {
    margin: 0.25rem 0 0;
    font-size: var(--text-sm);
    color: var(--lp-accent);
    font-weight: 500;
  }

  .lp-exp-meta {
    display: grid;
    justify-items: end;
    gap: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--lp-text-muted);
  }

  .lp-exp-bullets {
    margin: 0;
    padding-left: 1.15rem;
    display: grid;
    gap: 0.45rem;
    color: var(--lp-text);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .lp-exp-bullets li::marker {
    color: var(--lp-accent);
  }

  .lp-exp-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .lp-tech-pill {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--lp-text);
    background: rgba(14, 23, 38, 0.75);
    border: 1px solid var(--lp-border);
    padding: 0.26rem 0.65rem;
    border-radius: 9999px;
  }

  .lp-edu-block {
    margin-top: clamp(3rem, 5vw, 4.5rem);
  }

  .lp-edu-heading {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--lp-text-strong);
    margin: 0 0 1.25rem;
  }

  .lp-edu-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.15rem;
  }

  .lp-edu-card {
    background: var(--lp-surface);
    border: 1px solid var(--lp-border);
    border-radius: 20px;
    padding: 1.35rem;
    display: grid;
    gap: 0.45rem;
  }

  .lp-edu-period {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--lp-accent);
  }

  .lp-edu-degree {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--lp-text-strong);
  }

  .lp-edu-inst {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--lp-text-muted);
  }

  @media (max-width: 640px) {
    .lp-exp-meta {
      justify-items: start;
    }
  }
</style>
