---
import type { ProfileData } from '../lib/content';

interface Props {
  profile: ProfileData;
}

const { profile } = Astro.props;
---

<footer class="lp-footer">
  <div class="lp-footer-inner">
    <div class="lp-footer-upper">
      <div class="lp-footer-id">
        <h2 class="lp-footer-name">{profile.name.toUpperCase()}</h2>
        <p class="lp-footer-sub">
          {profile.headline} &middot; {profile.location}
        </p>
        <div class="lp-footer-contact-row">
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          <span>&middot;</span>
          <span>{profile.location}</span>
        </div>
      </div>

      <div class="lp-footer-ctas">
        <a
          href="/resume/Swapon-Islam-Resume.pdf"
          class="lp-btn-outline"
          target="_blank"
          rel="noopener"
        >
          Resume (PDF)
        </a>
        <button type="button" class="lp-btn-mint" data-open-contact>
          Get In Touch
        </button>
      </div>
    </div>

    <div class="lp-footer-lower">
      <nav class="lp-footer-nav" aria-label="Footer navigation">
        <a href="/#about">About</a>
        <a href="/#services">Expertise</a>
        <a href="/#projects">Projects</a>
        <a href="/#experience">Experience</a>
        <button type="button" class="lp-footer-link-btn" data-open-contact>
          Contact
        </button>
      </nav>

      <div class="lp-footer-icons">
        <a
          href={profile.links.github}
          target="_blank"
          rel="noopener"
          class="lp-icon-circle"
          aria-label="GitHub"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z" />
          </svg>
        </a>
        <a
          href={profile.links.linkedin}
          target="_blank"
          rel="noopener"
          class="lp-icon-circle"
          aria-label="LinkedIn"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77Z" />
          </svg>
        </a>
        <a href="#top" class="lp-icon-circle" aria-label="Back to top">
          &uarr;
        </a>
      </div>
    </div>

    <div class="lp-footer-copy">
      <span>&copy; {new Date().getFullYear()} {profile.name}. All rights reserved.</span>
      <span>Built with Astro &amp; WebGL</span>
    </div>
  </div>
</footer>

<style>
  .lp-footer {
    background: #09101b;
    border-top: 1px solid var(--lp-border);
    padding-block: clamp(3.5rem, 6vw, 5rem) 2rem;
  }

  .lp-footer-inner {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 2.5rem);
    display: grid;
    gap: 2.5rem;
  }

  .lp-footer-upper {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--lp-border);
  }

  .lp-footer-id {
    display: grid;
    gap: 0.45rem;
  }

  .lp-footer-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.2vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--lp-text-strong);
  }

  .lp-footer-sub {
    margin: 0;
    color: var(--lp-text);
    font-size: var(--text-sm);
  }

  .lp-footer-contact-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--lp-text-muted);
  }

  .lp-footer-contact-row a {
    color: var(--lp-accent);
    text-decoration: none;
  }

  .lp-footer-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .lp-btn-mint {
    padding: 0.72rem 1.45rem;
    border-radius: 9999px;
    border: none;
    background: var(--lp-accent);
    color: #09101b;
    font-weight: 600;
    font-size: 0.88rem;
    cursor: pointer;
  }

  .lp-btn-outline {
    padding: 0.72rem 1.45rem;
    border-radius: 9999px;
    border: 1px solid var(--lp-border-strong);
    color: var(--lp-text-strong);
    font-weight: 600;
    font-size: 0.88rem;
    text-decoration: none;
  }

  .lp-footer-lower {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .lp-footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .lp-footer-nav a,
  .lp-footer-link-btn {
    color: var(--lp-text);
    text-decoration: none;
    font-size: 0.88rem;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }

  .lp-footer-nav a:hover,
  .lp-footer-link-btn:hover {
    color: var(--lp-accent);
  }

  .lp-footer-icons {
    display: flex;
    gap: 0.6rem;
  }

  .lp-icon-circle {
    width: 38px;
    height: 38px;
    border-radius: 9999px;
    border: 1px solid var(--lp-border);
    display: grid;
    place-items: center;
    color: var(--lp-text);
    text-decoration: none;
    transition: border-color 180ms ease, color 180ms ease;
  }

  .lp-icon-circle:hover {
    border-color: var(--lp-accent);
    color: var(--lp-accent);
  }

  .lp-footer-copy {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--lp-text-muted);
  }
</style>
