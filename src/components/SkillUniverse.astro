---
import GlassPanel from './GlassPanel.astro';
import type { SkillConstellation, SkillsData } from '../lib/content';

interface Props {
  skills: SkillsData;
  constellation: SkillConstellation;
  projectTitles: Map<string, string>;
}

const { skills, constellation, projectTitles } = Astro.props;

type CategoryId = SkillsData['categories'][number]['id'];

const HUB_COORDS: Record<CategoryId, { x: number; y: number; rx: number; ry: number }> = {
  engines: { x: 195, y: 145, rx: 105, ry: 74 },
  programming: { x: 750, y: 150, rx: 128, ry: 88 },
  'xr-spatial': { x: 475, y: 315, rx: 155, ry: 105 },
  'game-dev': { x: 195, y: 470, rx: 95, ry: 68 },
  'ai-emerging': { x: 760, y: 470, rx: 105, ry: 68 },
};

const SOURCE_LABELS: Record<'resume' | 'github-readme' | 'tulip-generic', string> = {
  resume: 'Resume',
  'github-readme': 'GitHub Profile',
  'tulip-generic': 'XR & CV Work',
};

interface PositionedNode {
  name: string;
  categoryId: CategoryId;
  categoryLabel: string;
  sourceLabel: string;
  projectIds: string[];
  x: number;
  y: number;
  labelAnchor: 'start' | 'middle' | 'end';
  labelDx: number;
  labelDy: number;
}

const nodeLookup = new Map<string, PositionedNode>();
const positionedNodes: PositionedNode[] = [];

for (const category of skills.categories) {
  const hub = HUB_COORDS[category.id];
  const count = category.skills.length;

  category.skills.forEach((skill, idx) => {
    const constellationNode = constellation.nodes.find((n) => n.name === skill.name);
    const projectIds = constellationNode?.projectIds ?? skill.relatedProjects;

    let x = hub.x;
    let y = hub.y;

    if (category.id === 'xr-spatial' && count > 8) {
      const innerCount = 5;
      if (idx < innerCount) {
        const angle = (idx / innerCount) * Math.PI * 2 - Math.PI / 2;
        x = Math.round(hub.x + Math.cos(angle) * 78);
        y = Math.round(hub.y + Math.sin(angle) * 56);
      } else {
        const outerIdx = idx - innerCount;
        const outerCount = count - innerCount;
        const angle = (outerIdx / outerCount) * Math.PI * 2 - Math.PI / 2.2;
        x = Math.round(hub.x + Math.cos(angle) * hub.rx);
        y = Math.round(hub.y + Math.sin(angle) * hub.ry);
      }
    } else {
      const angle = (idx / Math.max(count, 1)) * Math.PI * 2 - Math.PI / 2;
      x = Math.round(hub.x + Math.cos(angle) * hub.rx);
      y = Math.round(hub.y + Math.sin(angle) * hub.ry);
    }

    const dxFromHub = x - hub.x;
    const dyFromHub = y - hub.y;
    const labelAnchor: PositionedNode['labelAnchor'] =
      Math.abs(dxFromHub) < 22 ? 'middle' : dxFromHub > 0 ? 'start' : 'end';
    const labelDx = labelAnchor === 'middle' ? 0 : dxFromHub > 0 ? 11 : -11;
    const labelDy =
      labelAnchor === 'middle' ? (dyFromHub >= 0 ? 18 : -12) : 4;

    const positioned: PositionedNode = {
      name: skill.name,
      categoryId: category.id,
      categoryLabel: category.label,
      sourceLabel: SOURCE_LABELS[skill.source],
      projectIds,
      x,
      y,
      labelAnchor,
      labelDx,
      labelDy,
    };

    positionedNodes.push(positioned);
    nodeLookup.set(skill.name, positioned);
  });
}

const edgesWithCoords = constellation.edges
  .map((edge) => {
    const a = nodeLookup.get(edge.from);
    const b = nodeLookup.get(edge.to);
    if (!a || !b) return null;
    return {
      from: edge.from,
      to: edge.to,
      x1: a.x,
      y1: a.y,
      x2: b.x,
      y2: b.y,
      sharedCount: edge.sharedProjectIds.length,
    };
  })
  .filter((e): e is NonNullable<typeof e> => e !== null);

const defaultSkill =
  positionedNodes.find((n) => n.name === 'Unity') ?? positionedNodes[0];

const clientPayload = {
  defaultSkillName: defaultSkill?.name ?? '',
  skills: positionedNodes.map((n) => ({
    name: n.name,
    categoryLabel: n.categoryLabel,
    sourceLabel: n.sourceLabel,
    projects: n.projectIds.map((id) => ({
      id,
      title: projectTitles.get(id) ?? id,
    })),
    connectedSkills: constellation.edges
      .filter((e) => e.from === n.name || e.to === n.name)
      .map((e) => (e.from === n.name ? e.to : e.from)),
  })),
};
---

<section id="skills" class="section reveal" data-skill-universe>
  <div class="container">
    <div class="universe-header">
      <div class="section-head universe-head">
        <span class="eyebrow">Technology Universe</span>
        <h2 class="section-title">Skills &amp; Project Constellation</h2>
        <p class="section-subtitle">
          Lines connect technologies used together across verified projects. Select or focus any skill to inspect its connections.
        </p>
      </div>

      <div class="universe-mode-toggle glass-pill" role="group" aria-label="Skills view mode">
        <button
          type="button"
          class="mode-btn is-active"
          data-universe-mode="graph"
          aria-pressed="true"
        >
          Constellation
        </button>
        <button
          type="button"
          class="mode-btn"
          data-universe-mode="list"
          aria-pressed="false"
        >
          Grouped List
        </button>
      </div>
    </div>

    <div class="universe-layout">
      <GlassPanel variant="panel" padding="sm" class="universe-stage-panel">
        <div class="constellation-wrap" data-constellation-view>
          <svg
            class="constellation-svg"
            viewBox="0 0 960 600"
            role="img"
            aria-label="Interactive skill constellation connecting Engines, Programming, XR & Spatial, Game Dev, and AI & Emerging"
          >
            <g class="constellation-spokes" aria-hidden="true">
              {
                positionedNodes.map((node) => {
                  const hub = HUB_COORDS[node.categoryId];
                  return (
                    <line
                      x1={hub.x}
                      y1={hub.y}
                      x2={node.x}
                      y2={node.y}
                      class="spoke-line"
                    />
                  );
                })
              }
            </g>

            <g class="constellation-edges" aria-hidden="true">
              {
                edgesWithCoords.map((edge) => (
                  <line
                    x1={edge.x1}
                    y1={edge.y1}
                    x2={edge.x2}
                    y2={edge.y2}
                    class="co-edge"
                    data-edge-from={edge.from}
                    data-edge-to={edge.to}
                  />
                ))
              }
            </g>

            <g class="constellation-hubs" aria-hidden="true">
              {
                skills.categories.map((cat) => {
                  const hub = HUB_COORDS[cat.id];
                  return (
                    <g class="hub-group" transform={`translate(${hub.x}, ${hub.y})`}>
                      <circle r="24" class="hub-halo" />
                      <circle r="7" class="hub-core" />
                      <text y="-30" text-anchor="middle" class="hub-label">
                        {cat.label}
                      </text>
                    </g>
                  );
                })
              }
            </g>

            <g class="constellation-nodes">
              {
                positionedNodes.map((node) => {
                  const isDefault = node.name === defaultSkill?.name;
                  const hasProjects = node.projectIds.length > 0;
                  return (
                    <g
                      class:list={[
                        'constellation-node',
                        isDefault && 'is-selected',
                        hasProjects && 'has-projects',
                      ]}
                      transform={`translate(${node.x}, ${node.y})`}
                      tabindex="0"
                      role="button"
                      aria-pressed={isDefault ? 'true' : 'false'}
                      aria-label={`${node.name} (${node.categoryLabel}, ${node.projectIds.length} projects)`}
                      data-skill-node={node.name}
                    >
                      <circle r="16" class="node-hit" />
                      <circle r={hasProjects ? 6.5 : 4.5} class="node-dot" />
                      <text
                        x={node.labelDx}
                        y={node.labelDy}
                        text-anchor={node.labelAnchor}
                        class="node-label"
                      >
                        {node.name}
                      </text>
                    </g>
                  );
                })
              }
            </g>
          </svg>
        </div>

        <div class="grouped-list-wrap" data-list-view hidden>
          <div class="grouped-categories">
            {
              skills.categories.map((cat) => (
                <div class="grouped-cat">
                  <h3 class="grouped-cat-title">{cat.label}</h3>
                  <div class="grouped-cat-skills">
                    {cat.skills.map((skill) => (
                      <button
                        type="button"
                        class:list={[
                          'chip grouped-skill-btn',
                          skill.name === defaultSkill?.name && 'is-selected',
                        ]}
                        data-skill-trigger={skill.name}
                        aria-pressed={skill.name === defaultSkill?.name ? 'true' : 'false'}
                      >
                        {skill.name}
                      </button>
                    ))}
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </GlassPanel>

      <GlassPanel
        as="aside"
        variant="panel"
        padding="md"
        class="universe-inspector"
        ariaLabel="Selected skill details"
      >
        <div class="inspector-inner" aria-live="polite" data-skill-inspector>
          <div class="inspector-head">
            <span class="chip" data-inspector-category>
              {defaultSkill?.categoryLabel}
            </span>
            <span class="chip" data-inspector-source>
              {defaultSkill?.sourceLabel}
            </span>
          </div>

          <h3 class="inspector-title" data-inspector-title>
            {defaultSkill?.name}
          </h3>

          <div class="inspector-block">
            <h4 class="inspector-subhead">Related Projects</h4>
            <ul class="inspector-projects" data-inspector-projects>
              {
                defaultSkill && defaultSkill.projectIds.length > 0 ? (
                  defaultSkill.projectIds.map((slug) => (
                    <li>
                      <a
                        class="inspector-project-link"
                        href={`#project-${slug}`}
                        data-jump-project={slug}
                      >
                        {projectTitles.get(slug) ?? slug}
                      </a>
                    </li>
                  ))
                ) : (
                  <li class="inspector-empty">
                    Verified in profile sources; no public project linked yet.
                  </li>
                )
              }
            </ul>
          </div>

          <div class="inspector-block">
            <h4 class="inspector-subhead">Used Alongside</h4>
            <div class="inspector-co-skills" data-inspector-coskills>
              {
                constellation.edges
                  .filter(
                    (e) =>
                      e.from === defaultSkill?.name || e.to === defaultSkill?.name
                  )
                  .slice(0, 8)
                  .map((e) => {
                    const peer =
                      e.from === defaultSkill?.name ? e.to : e.from;
                    return (
                      <button
                        type="button"
                        class="chip co-skill-btn"
                        data-skill-trigger={peer}
                      >
                        {peer}
                      </button>
                    );
                  })
              }
            </div>
          </div>
        </div>
      </GlassPanel>
    </div>
  </div>

  <script
    is:inline
    type="application/json"
    data-constellation-data
    set:html={JSON.stringify(clientPayload)}
  />
</section>

<style>
  .universe-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    margin-bottom: clamp(1.5rem, 2.8vw, 2.25rem);
  }

  .universe-head {
    margin-bottom: 0;
  }

  .universe-mode-toggle {
    display: inline-flex;
    padding: 0.25rem;
    gap: 0.25rem;
  }

  .mode-btn {
    border: none;
    background: transparent;
    color: var(--text-secondary);
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color var(--duration-fast) ease,
      color var(--duration-fast) ease;
  }

  .mode-btn.is-active {
    background: var(--glass-pill-hover);
    color: var(--text-primary);
  }

  .universe-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(270px, 0.85fr);
    gap: 1.25rem;
    align-items: stretch;
  }

  .universe-stage-panel {
    display: grid;
    align-items: center;
  }

  .constellation-svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .spoke-line {
    stroke: var(--glass-border);
    stroke-width: 1;
    stroke-dasharray: 2 4;
    opacity: 0.55;
  }

  .co-edge {
    stroke: var(--accent-blue);
    stroke-width: 1;
    opacity: 0.14;
    transition: opacity var(--duration-fast) ease, stroke-width var(--duration-fast) ease;
  }

  .co-edge.is-connected {
    stroke: var(--accent-blue);
    stroke-width: 2;
    opacity: 0.72;
  }

  .co-edge.is-dimmed {
    opacity: 0.05;
  }

  .hub-halo {
    fill: rgba(96, 165, 250, 0.08);
    stroke: var(--glass-border-strong);
    stroke-width: 1;
  }

  .hub-core {
    fill: var(--accent-violet);
  }

  .hub-label {
    fill: var(--accent-blue);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .constellation-node {
    cursor: pointer;
    outline: none;
  }

  .node-hit {
    fill: transparent;
  }

  .node-dot {
    fill: var(--text-secondary);
    stroke: var(--bg-base);
    stroke-width: 1.5;
    transition: transform var(--duration-fast) var(--ease-spring), fill var(--duration-fast) ease;
  }

  .constellation-node.has-projects .node-dot {
    fill: var(--accent-blue);
  }

  .node-label {
    fill: var(--text-secondary);
    font-size: 11.5px;
    font-weight: 500;
    transition: fill var(--duration-fast) ease;
    pointer-events: none;
  }

  .constellation-node:hover .node-dot,
  .constellation-node:focus-visible .node-dot,
  .constellation-node.is-selected .node-dot {
    fill: var(--text-primary);
    transform: scale(1.35);
    filter: drop-shadow(0 0 8px rgba(96, 165, 250, 0.8));
  }

  .constellation-node:hover .node-label,
  .constellation-node:focus-visible .node-label,
  .constellation-node.is-selected .node-label {
    fill: var(--text-primary);
    font-weight: 700;
  }

  .constellation-node.is-peer .node-dot {
    fill: var(--accent-violet);
  }

  .constellation-node.is-peer .node-label {
    fill: var(--text-primary);
  }

  /* Grouped List View */
  .grouped-list-wrap[hidden] {
    display: none;
  }

  .grouped-categories {
    display: grid;
    gap: 1.25rem;
    padding: 0.5rem;
  }

  .grouped-cat-title {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--accent-blue);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.55rem;
  }

  .grouped-cat-skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .grouped-skill-btn,
  .co-skill-btn {
    cursor: pointer;
    transition:
      background-color var(--duration-fast) ease,
      border-color var(--duration-fast) ease,
      color var(--duration-fast) ease;
  }

  .grouped-skill-btn.is-selected,
  .grouped-skill-btn:hover,
  .co-skill-btn:hover {
    background: var(--glass-pill-hover);
    border-color: var(--glass-border-strong);
    color: var(--text-primary);
  }

  /* Inspector Side Panel */
  .inspector-inner {
    display: grid;
    gap: 1.1rem;
    align-content: start;
  }

  .inspector-head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .inspector-title {
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .inspector-block {
    display: grid;
    gap: 0.55rem;
  }

  .inspector-subhead {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin: 0;
  }

  .inspector-projects {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }

  .inspector-project-link {
    display: inline-flex;
    align-items: center;
    width: 100%;
    padding: 0.52rem 0.8rem;
    border-radius: var(--radius-sm);
    background: var(--glass-pill-bg);
    border: 1px solid var(--glass-border);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-primary);
    transition: background-color var(--duration-fast) ease, border-color var(--duration-fast) ease;
  }

  .inspector-project-link:hover {
    background: var(--glass-pill-hover);
    border-color: var(--glass-border-strong);
  }

  .inspector-empty {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .inspector-co-skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  @media (max-width: 980px) {
    .universe-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .universe-mode-toggle {
      display: none;
    }

    .constellation-wrap {
      display: none;
    }

    .grouped-list-wrap {
      display: block !important;
    }
  }
</style>

<script>
  interface SkillRecord {
    name: string;
    categoryLabel: string;
    sourceLabel: string;
    projects: Array<{ id: string; title: string }>;
    connectedSkills: string[];
  }

  interface ConstellationPayload {
    defaultSkillName: string;
    skills: SkillRecord[];
  }

  let cleanupUniverse: (() => void) | null = null;

  function initSkillUniverse(): void {
    cleanupUniverse?.();
    const root = document.querySelector<HTMLElement>('[data-skill-universe]');
    if (!root) return;

    const dataEl = root.querySelector<HTMLScriptElement>('[data-constellation-data]');
    if (!dataEl?.textContent) return;

    let payload: ConstellationPayload;
    try {
      payload = JSON.parse(dataEl.textContent) as ConstellationPayload;
    } catch {
      return;
    }

    const skillMap = new Map<string, SkillRecord>(
      payload.skills.map((s) => [s.name, s])
    );

    const controller = new AbortController();
    const { signal } = controller;

    const nodes = Array.from(
      root.querySelectorAll<SVGGElement>('[data-skill-node]')
    );
    const edges = Array.from(
      root.querySelectorAll<SVGLineElement>('[data-edge-from]')
    );

    const categoryEl = root.querySelector<HTMLElement>('[data-inspector-category]');
    const sourceEl = root.querySelector<HTMLElement>('[data-inspector-source]');
    const titleEl = root.querySelector<HTMLElement>('[data-inspector-title]');
    const projectsEl = root.querySelector<HTMLElement>('[data-inspector-projects]');
    const coSkillsEl = root.querySelector<HTMLElement>('[data-inspector-coskills]');

    const constellationView = root.querySelector<HTMLElement>('[data-constellation-view]');
    const listView = root.querySelector<HTMLElement>('[data-list-view]');
    const modeBtns = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[data-universe-mode]')
    );

    const selectSkill = (skillName: string) => {
      const record = skillMap.get(skillName);
      if (!record) return;

      const peerSet = new Set(record.connectedSkills);

      nodes.forEach((node) => {
        const name = node.dataset.skillNode || '';
        const isSelected = name === skillName;
        const isPeer = !isSelected && peerSet.has(name);
        node.classList.toggle('is-selected', isSelected);
        node.classList.toggle('is-peer', isPeer);
        node.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
      });

      edges.forEach((edge) => {
        const from = edge.dataset.edgeFrom || '';
        const to = edge.dataset.edgeTo || '';
        const connected = from === skillName || to === skillName;
        edge.classList.toggle('is-connected', connected);
        edge.classList.toggle('is-dimmed', !connected);
      });

      root
        .querySelectorAll<HTMLButtonElement>('.grouped-skill-btn')
        .forEach((btn) => {
          const active = btn.dataset.skillTrigger === skillName;
          btn.classList.toggle('is-selected', active);
          btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        });

      if (categoryEl) categoryEl.textContent = record.categoryLabel;
      if (sourceEl) sourceEl.textContent = record.sourceLabel;
      if (titleEl) titleEl.textContent = record.name;

      if (projectsEl) {
        projectsEl.textContent = '';
        if (record.projects.length === 0) {
          const li = document.createElement('li');
          li.className = 'inspector-empty';
          li.textContent = 'Verified in profile sources; no public project linked yet.';
          projectsEl.appendChild(li);
        } else {
          record.projects.forEach((proj) => {
            const li = document.createElement('li');
            const a = document.createElement('a');
            a.className = 'inspector-project-link';
            a.href = `#project-${proj.id}`;
            a.dataset.jumpProject = proj.id;
            a.textContent = proj.title;
            li.appendChild(a);
            projectsEl.appendChild(li);
          });
        }
      }

      if (coSkillsEl) {
        coSkillsEl.textContent = '';
        if (record.connectedSkills.length === 0) {
          const span = document.createElement('span');
          span.className = 'inspector-empty';
          span.textContent = 'No cross-project links recorded yet.';
          coSkillsEl.appendChild(span);
        } else {
          record.connectedSkills.slice(0, 8).forEach((peer) => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'chip co-skill-btn';
            btn.dataset.skillTrigger = peer;
            btn.textContent = peer;
            coSkillsEl.appendChild(btn);
          });
        }
      }
    };

    nodes.forEach((node) => {
      const name = node.dataset.skillNode;
      if (!name) return;

      node.addEventListener('pointerenter', () => selectSkill(name), { signal });
      node.addEventListener('focus', () => selectSkill(name), { signal });
      node.addEventListener('click', () => selectSkill(name), { signal });
      node.addEventListener(
        'keydown',
        (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            selectSkill(name);
          }
        },
        { signal }
      );
    });

    root.addEventListener(
      'click',
      (event) => {
        const target = (event.target as HTMLElement)?.closest<HTMLButtonElement>(
          '[data-skill-trigger]'
        );
        if (target?.dataset.skillTrigger) {
          selectSkill(target.dataset.skillTrigger);
        }
      },
      { signal }
    );

    modeBtns.forEach((btn) => {
      btn.addEventListener(
        'click',
        () => {
          const mode = btn.dataset.universeMode;
          const isList = mode === 'list';
          modeBtns.forEach((b) => {
            const active = b === btn;
            b.classList.toggle('is-active', active);
            b.setAttribute('aria-pressed', active ? 'true' : 'false');
          });
          if (constellationView) constellationView.hidden = isList;
          if (listView) listView.hidden = !isList;
        },
        { signal }
      );
    });

    if (payload.defaultSkillName) {
      selectSkill(payload.defaultSkillName);
    }

    cleanupUniverse = () => controller.abort();
  }

  document.addEventListener('astro:page-load', initSkillUniverse);
</script>
