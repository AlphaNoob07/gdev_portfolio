---
import GlassPanel from './GlassPanel.astro';
import type { ExperienceEntry } from '../lib/content';

interface Props {
  entries: ExperienceEntry[];
  projectTitles: Map<string, string>;
}

const { entries, projectTitles } = Astro.props;
---

<section id="experience" class="section reveal">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Experience</span>
      <h2 class="section-title">Career Timeline</h2>
      <p class="section-subtitle">
        Building games, interactive simulations, and XR applications since January 2015.
      </p>
    </div>

    <ol class="timeline">
      {
        entries.map((entry) => (
          <li class="timeline-item">
            <span class="timeline-marker" aria-hidden="true" />
            <GlassPanel as="article" variant="card" padding="md" interactive>
              <div class="timeline-head">
                <div>
                  <h3 class="timeline-role">{entry.data.role}</h3>
                  <p class="timeline-company">
                    {entry.data.companyUrl ? (
                      <a
                        href={entry.data.companyUrl}
                        target="_blank"
                        rel="noopener"
                      >
                        {entry.data.company}
                      </a>
                    ) : (
                      entry.data.company
                    )}
                    {entry.data.companyNote && (
                      <span class="timeline-note">
                        {' '}— {entry.data.companyNote}
                      </span>
                    )}
                  </p>
                </div>
                <div class="timeline-meta">
                  <span class="chip">{entry.data.period}</span>
                  <span class="timeline-location">{entry.data.location}</span>
                </div>
              </div>

              {entry.data.summary && (
                <p class="timeline-summary">{entry.data.summary}</p>
              )}

              <ul class="timeline-points">
                {entry.data.responsibilities.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>

              <div class="timeline-footer">
                <div class="timeline-chips" aria-label="Technologies used">
                  {entry.data.tech.map((item) => (
                    <span class="chip">{item}</span>
                  ))}
                </div>

                {entry.data.relatedProjects.length > 0 && (
                  <div class="timeline-projects" aria-label="Related projects">
                    <span class="timeline-projects-label">Related:</span>
                    {entry.data.relatedProjects.map((slug) => (
                      <a
                        class="chip timeline-project-link"
                        href={`#project-${slug}`}
                        data-jump-project={slug}
                      >
                        {projectTitles.get(slug) ?? slug}
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </GlassPanel>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .timeline {
    position: relative;
    list-style: none;
    padding: 0 0 0 2rem;
    margin: 0;
    display: grid;
    gap: 1.25rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0.5rem;
    top: 0.75rem;
    bottom: 0.75rem;
    width: 2px;
    background: linear-gradient(
      180deg,
      var(--accent-blue) 0%,
      var(--accent-violet) 50%,
      var(--glass-border) 100%
    );
    border-radius: 9999px;
  }

  .timeline-item {
    position: relative;
  }

  .timeline-marker {
    position: absolute;
    left: -1.94rem;
    top: 1.55rem;
    width: 14px;
    height: 14px;
    border-radius: 9999px;
    background: var(--bg-base);
    border: 2.5px solid var(--accent-blue);
    box-shadow: 0 0 14px rgba(96, 165, 250, 0.65);
  }

  .timeline-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem 1.25rem;
    margin-bottom: 0.85rem;
  }

  .timeline-role {
    font-size: var(--text-lg);
    font-weight: 650;
    letter-spacing: -0.015em;
  }

  .timeline-company {
    color: var(--accent-blue);
    font-size: var(--text-sm);
    font-weight: 550;
    margin-top: 0.15rem;
  }

  .timeline-company a {
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .timeline-company a:hover {
    border-bottom-color: currentColor;
  }

  .timeline-note {
    color: var(--text-secondary);
    font-weight: 400;
  }

  .timeline-meta {
    display: grid;
    justify-items: end;
    gap: 0.25rem;
  }

  .timeline-location {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .timeline-summary {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    margin-bottom: 0.65rem;
  }

  .timeline-points {
    padding-left: 1.15rem;
    display: grid;
    gap: 0.4rem;
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }

  .timeline-footer {
    display: grid;
    gap: 0.75rem;
    margin-top: 1rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--glass-border);
  }

  .timeline-chips,
  .timeline-projects {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
  }

  .timeline-projects-label {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-muted);
  }

  .timeline-project-link {
    text-decoration: none;
    color: var(--text-primary);
  }

  .timeline-project-link:hover {
    background: var(--glass-pill-hover);
    border-color: var(--glass-border-strong);
  }

  @media (max-width: 640px) {
    .timeline {
      padding-left: 1.45rem;
    }

    .timeline::before {
      left: 0.35rem;
    }

    .timeline-marker {
      left: -1.5rem;
      width: 12px;
      height: 12px;
    }

    .timeline-meta {
      justify-items: start;
    }
  }
</style>
