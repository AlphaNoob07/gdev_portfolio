---
import { getImage, Picture } from 'astro:assets';
import Base from './Base.astro';
import GlassPanel from '../components/GlassPanel.astro';
import Lightbox, { type LightboxItem } from '../components/Lightbox.astro';
import { getProfile, type ProjectEntry } from '../lib/content';
import {
  getMediaType,
  isImageMetadata,
  resolveProjectImage,
} from '../lib/media';

interface Props {
  project: ProjectEntry;
  prevProject?: ProjectEntry | null;
  nextProject?: ProjectEntry | null;
  relatedProjects?: ProjectEntry[];
  hasBody?: boolean;
}

const {
  project,
  prevProject = null,
  nextProject = null,
  relatedProjects = [],
  hasBody = false,
} = Astro.props;

const profile = await getProfile();
const { data } = project;

const posterAsset = resolveProjectImage(data.poster);
const posterIsMetadata = isImageMetadata(posterAsset);
const posterStringUrl = typeof posterAsset === 'string' ? posterAsset : undefined;

const ogImage = posterIsMetadata
  ? (await getImage({ src: posterAsset, format: 'png', width: 1200 })).src
  : posterStringUrl;

const galleryEntries = await Promise.all(
  data.gallery.map(async (item, index) => {
    const type = getMediaType(item.src);
    const resolved = type === 'image' ? resolveProjectImage(item.src) : item.src;
    const isMeta = isImageMetadata(resolved);
    let lightboxSrc = typeof resolved === 'string' ? resolved : item.src;

    if (isMeta) {
      const optimized = await getImage({
        src: resolved,
        format: 'webp',
        width: 1600,
      });
      lightboxSrc = optimized.src;
    }

    return {
      index,
      type,
      resolved,
      isMeta,
      alt: item.alt,
      caption: item.caption,
      lightboxItem: {
        src: lightboxSrc,
        alt: item.alt,
        caption: item.caption,
        type,
      } satisfies LightboxItem,
    };
  })
);

const lightboxItems: LightboxItem[] = galleryEntries.map((g) => g.lightboxItem);

const creativeWorkJsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: data.title,
  description: data.summary,
  keywords: data.tech,
  author: {
    '@type': 'Person',
    name: profile.name,
  },
  ...(data.year ? { dateCreated: data.year } : {}),
  ...(data.links?.live ? { url: data.links.live } : {}),
  ...(data.links?.repo ? { codeRepository: data.links.repo } : {}),
};

const hasHeroMedia = Boolean(posterAsset || data.previewVideo);
const hasOverview = Boolean(data.caseStudy?.overview);
const hasObjectives = Boolean(data.caseStudy?.objectives?.length);
const hasRoleContext = Boolean(data.role || data.organization || data.year);
const hasChallenges = Boolean(data.caseStudy?.challenges?.length);
const hasSolutions = Boolean(data.caseStudy?.solutions?.length);
const hasOutcomes = Boolean(data.caseStudy?.outcomes?.length);
---

<Base
  title={`${data.title} — ${profile.name}`}
  description={data.summary}
  ogType="article"
  ogImage={ogImage}
  jsonLd={creativeWorkJsonLd}
>
  <article class="case-study" data-project-slug={project.id}>
    <div class="container">
      <nav class="case-breadcrumb" aria-label="Breadcrumb">
        <a href="/#projects" class="chip case-back-link">
          &larr; Back to Projects
        </a>
      </nav>

      <GlassPanel variant="panel" padding="lg" class="case-hero">
        <div class="case-badges">
          {data.categories.map((cat) => <span class="chip">{cat}</span>)}
          {data.confidentiality === 'generic-only' && (
            <span class="chip case-generic-badge">
              Generic overview — client details private
            </span>
          )}
        </div>

        <h1 class="case-title">{data.title}</h1>
        <p class="case-summary">{data.summary}</p>

        {
          (data.links?.repo || data.links?.live || data.links?.video) && (
            <div class="case-actions">
              {data.links.live && (
                <a
                  class="btn btn-primary"
                  href={data.links.live}
                  target="_blank"
                  rel="noopener"
                >
                  Live Demo
                </a>
              )}
              {data.links.repo && (
                <a
                  class="btn"
                  href={data.links.repo}
                  target="_blank"
                  rel="noopener"
                >
                  GitHub Repo
                </a>
              )}
              {data.links.video && (
                <a
                  class="btn"
                  href={data.links.video}
                  target="_blank"
                  rel="noopener"
                >
                  Watch Video
                </a>
              )}
            </div>
          )
        }
      </GlassPanel>

      {
        hasHeroMedia && (
          <GlassPanel variant="panel" padding="sm" class="case-hero-media">
            {data.previewVideo ? (
              <video
                class="case-video"
                controls
                playsinline
                preload="none"
                poster={posterIsMetadata ? posterAsset.src : posterStringUrl}
              >
                <source src={data.previewVideo} type="video/mp4" />
              </video>
            ) : posterIsMetadata ? (
              <Picture
                src={posterAsset}
                formats={['avif', 'webp']}
                widths={[640, 960, 1280]}
                sizes="(max-width: 900px) 100vw, 1080px"
                alt={`${data.title} showcase`}
                class="case-poster"
              />
            ) : (
              posterStringUrl && (
                <img
                  src={posterStringUrl}
                  alt={`${data.title} showcase`}
                  class="case-poster"
                />
              )
            )}
          </GlassPanel>
        )
      }

      <div class="case-details-grid">
        <div class="case-main-col">
          {
            hasOverview && (
              <GlassPanel as="section" variant="card" padding="md">
                <h2 class="case-section-title">Overview</h2>
                <p class="case-prose">{data.caseStudy?.overview}</p>
              </GlassPanel>
            )
          }

          {
            hasObjectives && (
              <GlassPanel as="section" variant="card" padding="md">
                <h2 class="case-section-title">Objectives</h2>
                <ul class="case-list">
                  {data.caseStudy?.objectives?.map((item) => <li>{item}</li>)}
                </ul>
              </GlassPanel>
            )
          }

          {
            hasChallenges && (
              <GlassPanel as="section" variant="card" padding="md">
                <h2 class="case-section-title">Challenges</h2>
                <ul class="case-list">
                  {data.caseStudy?.challenges?.map((item) => <li>{item}</li>)}
                </ul>
              </GlassPanel>
            )
          }

          {
            hasSolutions && (
              <GlassPanel as="section" variant="card" padding="md">
                <h2 class="case-section-title">Solutions</h2>
                <ul class="case-list">
                  {data.caseStudy?.solutions?.map((item) => <li>{item}</li>)}
                </ul>
              </GlassPanel>
            )
          }

          {
            hasOutcomes && (
              <GlassPanel as="section" variant="card" padding="md">
                <h2 class="case-section-title">Outcomes</h2>
                <ul class="case-list">
                  {data.caseStudy?.outcomes?.map((item) => <li>{item}</li>)}
                </ul>
              </GlassPanel>
            )
          }

          {
            hasBody && (
              <GlassPanel as="section" variant="card" padding="md" class="case-mdx">
                <slot />
              </GlassPanel>
            )
          }
        </div>

        <aside class="case-side-col">
          {
            hasRoleContext && (
              <GlassPanel variant="card" padding="md">
                <h2 class="case-section-title">Role &amp; Context</h2>
                <dl class="case-dl">
                  {data.role && (
                    <div>
                      <dt>Role</dt>
                      <dd>{data.role}</dd>
                    </div>
                  )}
                  {data.organization && (
                    <div>
                      <dt>Organization</dt>
                      <dd>{data.organization}</dd>
                    </div>
                  )}
                  {data.year && (
                    <div>
                      <dt>Year</dt>
                      <dd>{data.year}</dd>
                    </div>
                  )}
                </dl>
              </GlassPanel>
            )
          }

          <GlassPanel variant="card" padding="md">
            <h2 class="case-section-title">Tech Stack</h2>
            <div class="case-tech-chips">
              {data.tech.map((item) => <span class="chip">{item}</span>)}
            </div>
          </GlassPanel>
        </aside>
      </div>

      {
        galleryEntries.length > 0 && (
          <section class="case-gallery-section" aria-label="Media gallery">
            <h2 class="case-section-title">Media Gallery</h2>
            <div class="case-gallery-grid">
              {galleryEntries.map((item) => (
                <button
                  type="button"
                  class="glass-surface glass-card glass-spotlight gallery-thumb-btn"
                  data-spotlight="true"
                  data-lightbox-trigger
                  data-lightbox-index={item.index}
                  aria-label={`Open ${item.alt} in media viewer`}
                >
                  <div class="gallery-thumb-media">
                    {item.type === 'video' ? (
                      <div class="gallery-video-badge">
                        <span class="chip">Video</span>
                        <span>{item.alt}</span>
                      </div>
                    ) : item.isMeta && isImageMetadata(item.resolved) ? (
                      <Picture
                        src={item.resolved}
                        formats={['avif', 'webp']}
                        widths={[400, 720]}
                        sizes="(max-width: 768px) 100vw, 360px"
                        loading="lazy"
                        alt={item.alt}
                        class="gallery-thumb-img"
                      />
                    ) : (
                      <img
                        src={typeof item.resolved === 'string' ? item.resolved : ''}
                        alt={item.alt}
                        loading="lazy"
                        class="gallery-thumb-img"
                      />
                    )}
                  </div>
                  {item.caption && (
                    <span class="gallery-thumb-caption">{item.caption}</span>
                  )}
                </button>
              ))}
            </div>
          </section>
        )
      }

      {
        (prevProject || nextProject) && (
          <nav class="case-pager" aria-label="Project navigation">
            {prevProject ? (
              <a href={`/projects/${prevProject.id}`} class="case-pager-link">
                <GlassPanel variant="card" padding="md" interactive>
                  <span class="case-pager-dir">&larr; Previous Project</span>
                  <strong class="case-pager-title">{prevProject.data.title}</strong>
                </GlassPanel>
              </a>
            ) : (
              <div />
            )}

            {nextProject && (
              <a href={`/projects/${nextProject.id}`} class="case-pager-link case-pager-link--next">
                <GlassPanel variant="card" padding="md" interactive>
                  <span class="case-pager-dir">Next Project &rarr;</span>
                  <strong class="case-pager-title">{nextProject.data.title}</strong>
                </GlassPanel>
              </a>
            )}
          </nav>
        )
      }

      {
        relatedProjects.length > 0 && (
          <section class="case-related" aria-label="Related projects">
            <h2 class="case-section-title">Related Projects</h2>
            <div class="case-related-grid">
              {relatedProjects.map((rel) => (
                <a href={`/projects/${rel.id}`} class="case-related-link">
                  <GlassPanel variant="card" padding="md" interactive>
                    <h3 class="case-related-title">{rel.data.title}</h3>
                    <p class="case-related-summary">{rel.data.summary}</p>
                  </GlassPanel>
                </a>
              ))}
            </div>
          </section>
        )
      }
    </div>
  </article>

  <Lightbox items={lightboxItems} />
</Base>

<style>
  .case-study {
    padding-block: clamp(1.5rem, 3.5vw, 3rem) var(--space-section);
  }

  .case-breadcrumb {
    margin-bottom: 1.25rem;
  }

  .case-back-link {
    text-decoration: none;
    color: var(--text-primary);
  }

  .case-back-link:hover {
    background: var(--glass-pill-hover);
    border-color: var(--glass-border-strong);
  }

  :global(.case-hero) {
    display: grid;
    gap: 1rem;
  }

  .case-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .case-generic-badge {
    border-color: var(--glass-border-strong);
    color: var(--accent-blue);
  }

  .case-title {
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .case-summary {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    max-width: 68ch;
  }

  .case-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    padding-top: 0.35rem;
  }

  :global(.case-hero-media) {
    margin-top: 1.25rem;
  }

  .case-poster,
  .case-video {
    width: 100%;
    max-height: 560px;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }

  .case-details-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(250px, 0.85fr);
    gap: 1.25rem;
    margin-top: 1.35rem;
    align-items: start;
  }

  .case-main-col,
  .case-side-col {
    display: grid;
    gap: 1.15rem;
  }

  .case-section-title {
    font-size: var(--text-lg);
    font-weight: 650;
    margin-bottom: 0.75rem;
  }

  .case-prose {
    color: var(--text-secondary);
    font-size: var(--text-base);
    line-height: 1.7;
  }

  .case-list {
    padding-left: 1.2rem;
    display: grid;
    gap: 0.45rem;
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }

  .case-mdx {
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .case-dl {
    margin: 0;
    display: grid;
    gap: 0.8rem;
  }

  .case-dl dt {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    font-weight: 600;
  }

  .case-dl dd {
    margin: 0.15rem 0 0;
    font-size: var(--text-sm);
    color: var(--text-primary);
    font-weight: 500;
  }

  .case-tech-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .case-gallery-section,
  .case-related {
    margin-top: 2.25rem;
  }

  .case-gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }

  .gallery-thumb-btn {
    padding: 0;
    text-align: left;
    cursor: pointer;
    display: grid;
  }

  .gallery-thumb-media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .gallery-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery-video-badge {
    width: 100%;
    height: 100%;
    padding: 1rem;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 0.5rem;
    color: var(--text-primary);
    font-weight: 600;
  }

  .gallery-thumb-caption {
    padding: 0.7rem 0.9rem;
    font-size: var(--text-xs);
    color: var(--text-secondary);
    border-top: 1px solid var(--glass-border);
  }

  .case-pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2.25rem;
  }

  .case-pager-link,
  .case-related-link {
    text-decoration: none;
    color: inherit;
  }

  .case-pager-link--next {
    text-align: right;
  }

  .case-pager-dir {
    display: block;
    font-size: var(--text-xs);
    color: var(--accent-blue);
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .case-pager-title {
    font-size: var(--text-base);
    font-weight: 650;
  }

  .case-related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
  }

  .case-related-title {
    font-size: var(--text-base);
    font-weight: 650;
    margin-bottom: 0.4rem;
  }

  .case-related-summary {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  @media (max-width: 820px) {
    .case-details-grid,
    .case-pager {
      grid-template-columns: 1fr;
    }

    .case-pager-link--next {
      text-align: left;
    }
  }
</style>
