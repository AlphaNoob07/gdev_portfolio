---
import { desc } from 'drizzle-orm';
import Base from '../../layouts/Base.astro';
import GlassPanel from '../../components/GlassPanel.astro';
import { contactSubmissions } from '../../db/schema';
import { getAdminSession } from '../../lib/auth';
import { getDb } from '../../lib/db';
import { getAdminAnalytics } from '../../lib/umami';

export const prerender = false;

const session = getAdminSession(Astro.cookies);
if (!session) {
  return Astro.redirect('/admin/signin', 302);
}

const rangeParam = Astro.url.searchParams.get('range');
const rangeDays: 30 | 90 = rangeParam === '90' ? 90 : 30;

const db = getDb();
const [analytics, messages] = await Promise.all([
  getAdminAnalytics(rangeDays),
  db
    ? db
        .select()
        .from(contactSubmissions)
        .orderBy(desc(contactSubmissions.createdAt))
        .limit(50)
        .catch(() => [])
    : Promise.resolve([]),
]);

const fmt = new Intl.NumberFormat('en-US');

// Compute SVG trend bars when Umami series exists
const series = analytics.ok ? analytics.series : [];
const maxPoint = Math.max(1, ...series.map((p) => p.y));
const chartWidth = 680;
const chartHeight = 160;
const barWidth = series.length > 0 ? Math.max(4, Math.floor((chartWidth - 16) / series.length) - 2) : 8;
---

<Base
  title="Admin Dashboard — Swapon Islam"
  description="Protected analytics, inbox, and content administration."
  noindex={true}
>
  <section class="section admin-section">
    <div class="container">
      <GlassPanel variant="panel" padding="md" class="admin-topbar">
        <div class="admin-topbar-left">
          <span class="eyebrow">Admin Console</span>
          <h1 class="admin-title">
            Welcome, {session.name || session.login}
          </h1>
        </div>

        <div class="admin-topbar-actions">
          <div class="range-toggle glass-pill" role="group" aria-label="Analytics range">
            <a
              href="/admin?range=30"
              class:list={['range-link', rangeDays === 30 && 'is-active']}
            >
              30d
            </a>
            <a
              href="/admin?range=90"
              class:list={['range-link', rangeDays === 90 && 'is-active']}
            >
              90d
            </a>
          </div>
          <a href="/keystatic" class="btn">Open Keystatic CMS</a>
          <form method="POST" action="/api/auth/signout">
            <button type="submit" class="btn">Sign Out</button>
          </form>
        </div>
      </GlassPanel>

      <div class="admin-block">
        <h2 class="admin-heading">Analytics Overview ({rangeDays} days)</h2>
        {
          analytics.ok ? (
            <>
              <div class="kpi-grid">
                <GlassPanel variant="card" padding="md">
                  <span class="kpi-label">Visits</span>
                  <strong class="kpi-value">{fmt.format(analytics.totals.visits)}</strong>
                </GlassPanel>
                <GlassPanel variant="card" padding="md">
                  <span class="kpi-label">Unique Visitors</span>
                  <strong class="kpi-value">{fmt.format(analytics.totals.uniques)}</strong>
                </GlassPanel>
                <GlassPanel variant="card" padding="md">
                  <span class="kpi-label">Page Views</span>
                  <strong class="kpi-value">{fmt.format(analytics.totals.pageviews)}</strong>
                </GlassPanel>
                <GlassPanel variant="card" padding="md">
                  <span class="kpi-label">Active Now</span>
                  <strong class="kpi-value">{fmt.format(analytics.activeNow)}</strong>
                </GlassPanel>
              </div>

              {series.length > 0 && (
                <GlassPanel variant="panel" padding="md" class="chart-panel">
                  <h3 class="panel-subhead">Daily Pageviews ({rangeDays}d)</h3>
                  <svg
                    viewBox={`0 0 ${chartWidth} ${chartHeight}`}
                    class="trend-svg"
                    role="img"
                    aria-label={`${rangeDays}-day pageviews trend`}
                  >
                    {series.map((pt, idx) => {
                      const h = Math.max(2, Math.round((pt.y / maxPoint) * (chartHeight - 24)));
                      const x = 8 + idx * (barWidth + 2);
                      const y = chartHeight - 12 - h;
                      return (
                        <rect
                          x={x}
                          y={y}
                          width={barWidth}
                          height={h}
                          rx="3"
                          class="trend-bar"
                        >
                          <title>{`${pt.x}: ${pt.y} views`}</title>
                        </rect>
                      );
                    })}
                  </svg>
                </GlassPanel>
              )}

              <div class="traffic-grid">
                <GlassPanel variant="card" padding="md">
                  <h3 class="panel-subhead">Top Referrers</h3>
                  {analytics.referrers.length > 0 ? (
                    <ul class="metric-list">
                      {analytics.referrers.map((r) => (
                        <li>
                          <span>{r.x || '(Direct)'}</span>
                          <strong>{fmt.format(r.y)}</strong>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="empty-note">No referrer data yet.</p>
                  )}
                </GlassPanel>

                <GlassPanel variant="card" padding="md">
                  <h3 class="panel-subhead">Countries (Aggregate)</h3>
                  {analytics.countries.length > 0 ? (
                    <ul class="metric-list">
                      {analytics.countries.map((c) => (
                        <li>
                          <span>{c.x || 'Unknown'}</span>
                          <strong>{fmt.format(c.y)}</strong>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="empty-note">No country data yet.</p>
                  )}
                </GlassPanel>

                <GlassPanel variant="card" padding="md">
                  <h3 class="panel-subhead">Popular Pages</h3>
                  {analytics.pages.length > 0 ? (
                    <ul class="metric-list">
                      {analytics.pages.map((p) => (
                        <li>
                          <span>{p.x}</span>
                          <strong>{fmt.format(p.y)}</strong>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="empty-note">No page data yet.</p>
                  )}
                </GlassPanel>

                <GlassPanel variant="card" padding="md">
                  <h3 class="panel-subhead">Custom Events</h3>
                  {analytics.events.length > 0 ? (
                    <ul class="metric-list">
                      {analytics.events.map((ev) => (
                        <li>
                          <span>{ev.x}</span>
                          <strong>{fmt.format(ev.y)}</strong>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="empty-note">No custom events yet.</p>
                  )}
                </GlassPanel>
              </div>
            </>
          ) : (
            <GlassPanel variant="card" padding="md">
              <p class="empty-note">
                Stats unavailable. Set <code>UMAMI_API_KEY</code> and{' '}
                <code>UMAMI_WEBSITE_ID</code> to enable live analytics.
              </p>
            </GlassPanel>
          )
        }
      </div>

      <div class="admin-block">
        <h2 class="admin-heading">Content Management (Keystatic)</h2>
        <div class="cms-links">
          <a class="btn" href="/keystatic/collection/blog">Blog Posts</a>
          <a class="btn" href="/keystatic/collection/projects">Projects</a>
          <a class="btn" href="/keystatic/collection/testimonials">Testimonials</a>
          <a class="btn" href="/keystatic/collection/certifications">Certifications</a>
          <a class="btn" href="/keystatic/singleton/availability">Availability</a>
        </div>
      </div>

      <div class="admin-block">
        <h2 class="admin-heading">Contact Messages ({messages.length})</h2>
        {
          !db ? (
            <GlassPanel variant="card" padding="md">
              <p class="empty-note">
                Neon Postgres is not configured yet (<code>DATABASE_URL</code> missing).
              </p>
            </GlassPanel>
          ) : messages.length === 0 ? (
            <GlassPanel variant="card" padding="md">
              <p class="empty-note">No contact messages stored yet.</p>
            </GlassPanel>
          ) : (
            <div class="inbox-list" data-inbox-list>
              {messages.map((msg) => (
                <GlassPanel as="article" variant="card" padding="md" class="inbox-item">
                  <div class="inbox-head">
                    <div>
                      <h3 class="inbox-sender">
                        {msg.name} <span class="inbox-email">&lt;{msg.email}&gt;</span>
                      </h3>
                      {msg.subject && <p class="inbox-subject">{msg.subject}</p>}
                    </div>
                    <div class="inbox-badges">
                      <span class="chip" data-msg-status>{msg.status}</span>
                      <span class="chip">{msg.deliveryStatus}</span>
                    </div>
                  </div>

                  <p class="inbox-message">{msg.message}</p>

                  <div class="inbox-actions">
                    <a
                      class="chip inbox-action-link"
                      href={`mailto:${msg.email}?subject=${encodeURIComponent(`Re: ${msg.subject || 'Portfolio Inquiry'}`)}`}
                    >
                      Reply via Email
                    </a>
                    <button
                      type="button"
                      class="chip inbox-action-btn"
                      data-msg-action={msg.status === 'unread' ? 'mark_read' : 'mark_unread'}
                      data-msg-id={msg.id}
                    >
                      {msg.status === 'unread' ? 'Mark Read' : 'Mark Unread'}
                    </button>
                    <button
                      type="button"
                      class="chip inbox-action-btn"
                      data-msg-action="archive"
                      data-msg-id={msg.id}
                    >
                      Archive
                    </button>
                    <button
                      type="button"
                      class="chip inbox-action-btn"
                      data-msg-action="delete"
                      data-msg-id={msg.id}
                    >
                      Delete
                    </button>
                  </div>
                </GlassPanel>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .admin-section {
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  :global(.admin-topbar) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .admin-title {
    font-size: var(--text-xl);
    font-weight: 700;
  }

  .admin-topbar-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
  }

  .range-toggle {
    display: inline-flex;
    padding: 0.2rem;
    gap: 0.2rem;
  }

  .range-link {
    padding: 0.38rem 0.75rem;
    border-radius: var(--radius-pill);
    text-decoration: none;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-secondary);
  }

  .range-link.is-active {
    background: var(--glass-pill-hover);
    color: var(--text-primary);
  }

  .admin-block {
    margin-top: 2rem;
    display: grid;
    gap: 1rem;
  }

  .admin-heading {
    font-size: var(--text-lg);
    font-weight: 650;
  }

  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
  }

  .kpi-label {
    display: block;
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .kpi-value {
    display: block;
    margin-top: 0.35rem;
    font-size: var(--text-2xl);
    font-weight: 700;
  }

  .trend-svg {
    width: 100%;
    height: auto;
  }

  .trend-bar {
    fill: var(--accent-blue);
    opacity: 0.85;
  }

  .traffic-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }

  .panel-subhead {
    font-size: var(--text-base);
    font-weight: 650;
    margin-bottom: 0.75rem;
  }

  .metric-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.45rem;
    font-size: var(--text-sm);
  }

  .metric-list li {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    color: var(--text-secondary);
  }

  .metric-list strong {
    color: var(--text-primary);
  }

  .empty-note {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .cms-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .inbox-list {
    display: grid;
    gap: 1rem;
  }

  :global(.inbox-item) {
    display: grid;
    gap: 0.75rem;
  }

  .inbox-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.65rem;
  }

  .inbox-sender {
    font-size: var(--text-base);
    font-weight: 650;
  }

  .inbox-email {
    font-weight: 400;
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }

  .inbox-subject {
    font-size: var(--text-sm);
    color: var(--accent-blue);
    margin-top: 0.2rem;
  }

  .inbox-badges,
  .inbox-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .inbox-message {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    white-space: pre-wrap;
  }

  .inbox-action-link,
  .inbox-action-btn {
    cursor: pointer;
    text-decoration: none;
    color: var(--text-primary);
  }

  .inbox-action-btn:hover,
  .inbox-action-link:hover {
    background: var(--glass-pill-hover);
    border-color: var(--glass-border-strong);
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const inbox = document.querySelector<HTMLElement>('[data-inbox-list]');
    if (!inbox) return;

    inbox.addEventListener('click', async (event) => {
      const btn = (event.target as HTMLElement)?.closest<HTMLButtonElement>('[data-msg-action]');
      if (!btn) return;

      const id = Number(btn.dataset.msgId);
      const action = btn.dataset.msgAction;
      if (!id || !action) return;

      btn.disabled = true;
      try {
        const res = await fetch('/api/admin/messages', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id, action }),
        });
        if (res.ok) {
          window.location.reload();
        }
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>
