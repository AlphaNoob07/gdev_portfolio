---
import Base from '../layouts/Base.astro';
import LivingHero from '../components/LivingHero.astro';
import LivingAbout from '../components/LivingAbout.astro';
import LivingExpertise from '../components/LivingExpertise.astro';
import LivingProjects from '../components/LivingProjects.astro';
import LivingExperience from '../components/LivingExperience.astro';
import {
  getAvailability,
  getExperience,
  getProfile,
  getProjects,
  getSkills,
  validateContentIntegrity,
} from '../lib/content';

const [profile, availability, skills, experience, projects] = await Promise.all([
  getProfile(),
  getAvailability(),
  getSkills(),
  getExperience(),
  getProjects(),
]);

validateContentIntegrity(experience, skills, projects);
---

<Base>
  <LivingHero profile={profile} availability={availability} />
  <LivingAbout profile={profile} skills={skills} />
  <LivingExpertise />
  <LivingProjects projects={projects} />
  <LivingExperience entries={experience} profile={profile} />
</Base>
